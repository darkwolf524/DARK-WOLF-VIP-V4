	if followOn then
		stopFollow()
	else
		if makeTrollSelectMenu then
			makeTrollSelectMenu(startFollow, false)
		end
	end
end)


-- ========== FLING PLAYER (método BodyAngularVelocity + colisão) ==========
local flingBusy = false
local function flingPlayer(plr)
	if flingBusy or not plr or plr == P or not plr.Character then return end
	local tChar = plr.Character
	local th = tChar:FindFirstChild("HumanoidRootPart")
	if not th then return end
	local char = P.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end
	flingBusy = true
	local oldPos = hrp.CFrame

	-- garante colisão pra empurrar o alvo
	local savedCollide = {}
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then
			savedCollide[p] = p.CanCollide
			p.CanCollide = true
		end
	end
	pcall(function()
		hrp.CanCollide = true
		hum.PlatformStand = true
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	end)

	-- gira o seu corpo com torque alto (fling clássico)
	local bav = Instance.new("BodyAngularVelocity")
	bav.Name = "DW_FlingSpin"
	bav.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	bav.P = 1e9
	bav.AngularVelocity = Vector3.new(0, 9e5, 0)
	bav.Parent = hrp

	local bv = Instance.new("BodyVelocity")
	bv.Name = "DW_FlingPush"
	bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bv.P = 1e9
	bv.Velocity = Vector3.new(0, 0, 0)
	bv.Parent = hrp

	local t0 = tick()
	local conn
	conn = R.Heartbeat:Connect(function()
		if not th.Parent or not hrp.Parent or tick() - t0 > 1.1 then
			if conn then conn:Disconnect() end
			return
		end
		-- cola no HumanoidRootPart do alvo
		local offset = CFrame.Angles(math.rad(math.random(-90, 90)), math.rad(math.random(-180, 180)), math.rad(math.random(-90, 90)))
		hrp.CFrame = th.CFrame * offset
		-- força linear absurda em direção aleatória + cima
		local force = Vector3.new(
			math.random(-1, 1) * 1e5,
			1e5,
			math.random(-1, 1) * 1e5
		)
		bv.Velocity = force
		pcall(function()
			hrp.AssemblyLinearVelocity = force
			hrp.AssemblyAngularVelocity = Vector3.new(0, 9e5, 0)
			-- tenta empurrar o alvo também (funciona só se tiver ownership)
			th.AssemblyLinearVelocity = force
			th.AssemblyAngularVelocity = Vector3.new(9e4, 9e4, 9e4)
		end)
	end)

	task.delay(1.15, function()
		if conn then conn:Disconnect() end
		pcall(function() if bav then bav:Destroy() end end)
		pcall(function() if bv then bv:Destroy() end end)
		for p, col in pairs(savedCollide) do
			if p and p.Parent then
				pcall(function() p.CanCollide = col end)
			end
		end
		if hrp and hrp.Parent then
			pcall(function()
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				hrp.CFrame = oldPos + Vector3.new(0, 3, 0)
			end)
		end
		if hum and hum.Parent then
			hum.PlatformStand = false
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		end
		flingBusy = false
	end)
end

btn("Fling Player", "FlingBtn", function()
	if makeTrollSelectMenu then
		makeTrollSelectMenu(function(plr)
			flingPlayer(plr)
		end, false)
	end
end)

-- ========== BEAN HEAD (vira feijão na cabeça do alvo) ==========
local beanOn = false
local beanConn = nil
local beanPart = nil
