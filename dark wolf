		last = hrp.Position
		local ice = Instance.new("Part")
		ice.Name = "IceStep"
		ice.Size = Vector3.new(2.4, 0.2, 2.4)
		ice.Anchored = true
		ice.CanCollide = false
		ice.Material = Enum.Material.Ice
