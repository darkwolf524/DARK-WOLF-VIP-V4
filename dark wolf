local function startFrozen()
	stopFrozen()
	frozenOn = true
	local last = Vector3.zero
	frozenConn = R.Heartbeat:Connect(function()
		if not frozenOn then return end
		local hrp = P.Character and P.Character:FindFirstChild("HumanoidRootPart")
		local hum = P.Character and P.Character:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.MoveDirection.Magnitude < 0.1 then return end
