local portalA, portalB = nil, nil
local portalFolder = Instance.new("Folder", WS)
portalFolder.Name = "DW_Portals"
local portalConn = nil
local portalNext = "A"
local portalGunTool = nil
local portalPlaceGui = nil

local function clearPortals()
	if portalConn then portalConn:Disconnect() portalConn = nil end
	for _, v in ipairs(portalFolder:GetChildren()) do
		pcall(function() v:Destroy() end)
	end
	portalA, portalB = nil, nil
	portalNext = "A"
end

local function makePortalPart(cf, name, col)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = Vector3.new(5, 7, 0.35)
	p.CFrame = cf
	p.Anchored = true
	p.CanCollide = false
	p.Material = Enum.Material.Neon
	p.Color = col
	p.Transparency = 0.2
	p.Parent = portalFolder
	local light = Instance.new("PointLight", p)
	light.Color = col
	light.Brightness = 2.5
	light.Range = 16
	local ring = Instance.new("SelectionBox")
	ring.Adornee = p
	ring.LineThickness = 0.05
	ring.Color3 = col
	ring.Parent = p
	return p
end

local function armPortals()
	if portalConn then portalConn:Disconnect() end
	local debounce = false
	portalConn = R.Heartbeat:Connect(function()
		if not portalA or not portalB then return end
		local hrp = P.Character and P.Character:FindFirstChild("HumanoidRootPart")
		if not hrp or debounce then return end
		if (hrp.Position - portalA.Position).Magnitude < 4.5 then
			debounce = true
			local look = portalB.CFrame.LookVector
			hrp.CFrame = CFrame.new(portalB.Position + look * 4 + Vector3.new(0, 2, 0), portalB.Position + look * 10)
			task.delay(1.0, function() debounce = false end)
		elseif (hrp.Position - portalB.Position).Magnitude < 4.5 then
			debounce = true
			local look = portalA.CFrame.LookVector
			hrp.CFrame = CFrame.new(portalA.Position + look * 4 + Vector3.new(0, 2, 0), portalA.Position + look * 10)
			task.delay(1.0, function() debounce = false end)
		end
	end)
end

local function raycastPortal()
	local cam = WS.CurrentCamera
	if not cam then return nil end
	local origin = cam.CFrame.Position
	local dir = cam.CFrame.LookVector * 500
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {P.Character, portalFolder}
	return WS:Raycast(origin, dir, params)
end

local function placePortalAtHit(result)
	if not result then return end
	local n = result.Normal
	local pos = result.Position + n * 0.2
	local cf = CFrame.lookAt(pos, pos + n)
	if portalNext == "A" then
		if portalA then portalA:Destroy() end
		portalA = makePortalPart(cf, "PortalA", Color3.fromRGB(80, 180, 255))
		portalNext = "B"
	else
		if portalB then portalB:Destroy() end
		portalB = makePortalPart(cf, "PortalB", Color3.fromRGB(255, 200, 40))
		portalNext = "A"
	end
	if portalA and portalB then armPortals() end
end

