-- Rejoin (volta pro jogo e recarrega o script sozinho)
function doRejoin()
	local function queueTeleportScript(code)
		pcall(function()
			if queue_on_teleport then
				queue_on_teleport(code)
			elseif queueonteleport then
				queueonteleport(code)
			elseif syn and syn.queue_on_teleport then
				syn.queue_on_teleport(code)
			elseif fluxus and fluxus.queue_on_teleport then
				fluxus.queue_on_teleport(code)
			elseif getgenv then
				local g = getgenv()
				if g.queue_on_teleport then g.queue_on_teleport(code)
				elseif g.queueonteleport then g.queueonteleport(code) end
			end
		end)
	end
	pcall(function()
		if writefile and getgenv and getgenv().DW_VIP_SOURCE then
			writefile("DARK_WOLF_VIP.lua", getgenv().DW_VIP_SOURCE)
		end
	end)
	local payload = [[
		repeat task.wait() until game:IsLoaded() and game.Players.LocalPlayer
		task.wait(1.2)
		pcall(function()
			if getgenv then getgenv().DW_SKIP_KEY = true end
			if writefile then writefile("DW_VIP_AUTH", "1") end
		end)
		pcall(function()
			if isfile and readfile and isfile("DARK_WOLF_VIP.lua") then
				loadstring(readfile("DARK_WOLF_VIP.lua"))()
				return
			end
		end)
		pcall(function()
			if isfile and readfile and isfile("autoexec/DARK_WOLF_VIP.lua") then
				loadstring(readfile("autoexec/DARK_WOLF_VIP.lua"))()
			end
		end)
	]]
	queueTeleportScript(payload)
	local ts = game:GetService("TeleportService")
	local ok = pcall(function()
		ts:TeleportToPlaceInstance(game.PlaceId, game.JobId, P)
	end)
	if not ok then
		pcall(function()
			ts:Teleport(game.PlaceId, P)
		end)
	end
end

