-- ========== GHOST ==========
local ghostOn = false
local ghostConn = nil
local ghostOrig = {}

local function setGhost(on)
	local c = P.Character
	if not c then return end
	if on then
		ghostOrig = {}
		for _, v in ipairs(c:GetDescendants()) do
			if v:IsA("BasePart") then
				ghostOrig[v] = {
					trans = v.LocalTransparencyModifier,
					collide = v.CanCollide,
				}
				v.LocalTransparencyModifier = 0.7
				if v.Name ~= "HumanoidRootPart" then
					v.CanCollide = false
				end
			elseif v:IsA("Decal") then
				ghostOrig[v] = { trans = v.Transparency }
				v.Transparency = math.clamp(v.Transparency + 0.5, 0, 1)
			end
		end
		if not ghostConn then
			ghostConn = R.Stepped:Connect(function()
				if not ghostOn or not P.Character then return end
				for _, v in ipairs(P.Character:GetDescendants()) do
					if v:IsA("BasePart") then
						v.LocalTransparencyModifier = 0.7
						if v.Name ~= "HumanoidRootPart" then
							v.CanCollide = false
						end
					end
				end
			end)
		end
	else
		if ghostConn then
			ghostConn:Disconnect()
			ghostConn = nil
		end
		for v, data in pairs(ghostOrig) do
			if v and v.Parent then
				pcall(function()
					if v:IsA("BasePart") then
						v.LocalTransparencyModifier = data.trans or 0
						v.CanCollide = data.collide ~= false
					elseif v:IsA("Decal") then
						v.Transparency = data.trans or 0
					end
				end)
			end
		end
		ghostOrig = {}
	end
end

