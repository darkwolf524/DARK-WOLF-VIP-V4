-- ========== CLONE PLAYER (Comandos Avançados) ==========
local cloneModel = nil
local function clearClone()
	if cloneModel then
		pcall(function() cloneModel:Destroy() end)
		cloneModel = nil
	end
	local b = B:FindFirstChild("ClonePlayerBtn")
	if b then b.Text = "Clone Player" end
end

local function startClonePlayer(plr)
	clearClone()
	if not plr or not plr.Character then return end
	local char = plr.Character

	local origin = char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
	if not origin then return end

	local snapshots = {}
	for _, v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart") then
			local rel = origin.CFrame:ToObjectSpace(v.CFrame)
			local acc = v:FindFirstAncestorOfClass("Accessory")
			snapshots[#snapshots + 1] = {
				name = v.Name,
				rel = rel,
				size = v.Size,
				color = v.Color,
				material = v.Material,
				transparency = v.Transparency,
				reflectance = v.Reflectance,
				meshId = (v:IsA("MeshPart") and v.MeshId) or nil,
				textureId = (v:IsA("MeshPart") and v.TextureID) or nil,
				shape = (v:IsA("Part") and v.Shape) or nil,
				original = v,
				accName = acc and acc.Name or nil,
			}
		end
	end

	local clone = Instance.new("Model")
	clone.Name = "DW_Clone_" .. plr.Name

	local cloneRoot = nil
	local clonedParts = {}

	for _, s in ipairs(snapshots) do
		if not s.accName then
			local c
			if s.meshId then
				c = Instance.new("MeshPart")
				c.MeshId = s.meshId
				if s.textureId then c.TextureID = s.textureId end
			else
				c = Instance.new("Part")
				if s.shape then c.Shape = s.shape end
			end
			c.Name = s.name
			c.Size = s.size
			c.Color = s.color
			c.Material = s.material
			c.Transparency = s.transparency
			c.Reflectance = s.reflectance
			c.Anchored = true
			c.CanCollide = false
			c.CanTouch = false
			c.CanQuery = false
			c.Massless = true
			c.CastShadow = true
			c.Parent = clone
			clonedParts[s.name] = c
			if s.name == "HumanoidRootPart" or (not cloneRoot and (s.name == "UpperTorso" or s.name == "Torso")) then
				cloneRoot = c
			end
			local sm = s.original:FindFirstChildOfClass("SpecialMesh")
			if sm then sm:Clone().Parent = c end
			for _, ch in ipairs(s.original:GetChildren()) do
				if ch:IsA("Decal") or ch:IsA("Texture") then
					ch:Clone().Parent = c
				end
			end
		end
	end

	if not cloneRoot then
		cloneRoot = clone:FindFirstChildWhichIsA("BasePart")
	end
	if not cloneRoot then
		clone:Destroy()
		return
	end

	local hum = Instance.new("Humanoid")
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.PlatformStand = true
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.AutoRotate = false
	hum.Parent = clone
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	end)

	for _, v in ipairs(char:GetChildren()) do
		if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("BodyColors") or v:IsA("CharacterMesh") then
			pcall(function() v:Clone().Parent = clone end)
		end
	end

	for _, s in ipairs(snapshots) do
		if s.accName then
			local c
			if s.meshId then
				c = Instance.new("MeshPart")
				c.MeshId = s.meshId
				if s.textureId then c.TextureID = s.textureId end
			else
				c = Instance.new("Part")
				if s.shape then c.Shape = s.shape end
				local sm = s.original:FindFirstChildOfClass("SpecialMesh")
				if sm then sm:Clone().Parent = c end
			end
			c.Name = s.accName .. "_Handle"
			c.Size = s.size
			c.Color = s.color
			c.Material = s.material
			c.Transparency = s.transparency
			c.Anchored = true
			c.CanCollide = false
			c.CanTouch = false
			c.Massless = true
			c.Parent = clone
			s._clonePart = c
		end
	end

	clone.PrimaryPart = cloneRoot
	clone.Parent = WS

	local myHRP = P.Character and P.Character:FindFirstChild("HumanoidRootPart")
	local baseCF = myHRP and (myHRP.CFrame * CFrame.new(0, 0, -4)) or (origin.CFrame * CFrame.new(0, 0, -4))

	for _, s in ipairs(snapshots) do
		if not s.accName then
			local c = clonedParts[s.name]
			if c then c.CFrame = baseCF * s.rel end
		end
	end
	for _, s in ipairs(snapshots) do
		if s.accName and s._clonePart then
			s._clonePart.CFrame = baseCF * s.rel
		end
	end

	if cloneRoot and cloneRoot.Name == "HumanoidRootPart" then
		cloneRoot.Transparency = 1
	end

	for _, p in ipairs(clone:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
			p.AssemblyLinearVelocity = Vector3.zero
			p.AssemblyAngularVelocity = Vector3.zero
		end
	end

	cloneModel = clone
	local b = B:FindFirstChild("ClonePlayerBtn")
	if b then b.Text = "Clone: " .. (plr == P and "EU" or plr.DisplayName) end
end

btn("Clone Player", "ClonePlayerBtn", function()
	if cloneModel then
		clearClone()
	else
		makeTrollSelectMenu(startClonePlayer, true)
	end
end)

P.CharacterAdded:Connect(function()
	clearClone()
end)

end
