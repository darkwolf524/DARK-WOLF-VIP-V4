		end
		-- lateral
		for _, v in ipairs(LeftNavBG:GetChildren()) do
			if v:IsA("UIStroke") then v.Color = c end
		end
		-- scrollbar
		B.ScrollBarImageColor3 = c
		-- pinta TODOS os detalhes de cor do menu
		for _, v in ipairs(M:GetDescendants()) do
			if v:IsA("Frame") then
				-- barras laterais dos botões (3px)
				if v.Size == UDim2.new(0, 3, 1, 0) or v.Size == UDim2.new(0, 5, 1, 0) then
					v.BackgroundColor3 = c
				end
			elseif v:IsA("UIStroke") then
				-- strokes que não sejam pretos/cinza muito escuros
				local col = v.Color
				local r, g, b = col.R, col.G, col.B
				if r > 0.15 or g > 0.1 or b > 0.1 then
					v.Color = c
				end
			elseif v:IsA("TextBox") then
				v.TextColor3 = c
			end
		end
		-- botões da nav esquerda quando selecionados (se tiverem cor de destaque)
		for _, v in ipairs(LN:GetChildren()) do
			if v:IsA("TextButton") then
				for _, ch in ipairs(v:GetChildren()) do
					if ch:IsA("UIStroke") then ch.Color = c end
				end
			end
		end
	end)
end

