local function shake(x)
	local p = x.Position
	for i = 1, 3 do
		x:TweenPosition(p + UDim2.new(0, -10, 0), "Out", "Linear", .04, true)
		task.wait(.04)
		x:TweenPosition(p + UDim2.new(0, 10, 0), "Out", "Linear", .04, true)
		task.wait(.04)
	end
	x:TweenPosition(p, "Out", "Linear", .05, true)
end

local function unlock()
	pcall(function()
		if writefile then writefile("DW_VIP_AUTH", "1") end
		if getgenv then getgenv().DW_VIP_AUTH = true end
	end)
	pcall(function()
		if KG then KG:Destroy() end
	end)
	M.Visible = true
	M.Size = UDim2.new(0, 500, 0, 450)
	M.BackgroundTransparency = 0.4
	TS:Create(M, TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 560, 0, 510),
		BackgroundTransparency = 0
	}):Play()
end

local function check()
	local t = tostring(KB.Text or ""):gsub("%s+", "")
	if t == KEY then
		unlock()
	else
		ML.Text = "KEY INVÁLIDA"
		shake(KF)
		task.wait(.6)
		ML.Text = ""
	end
end

