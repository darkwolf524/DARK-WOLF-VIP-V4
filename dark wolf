			myHum.AutoRotate = false
		end
		-- fica na cabeça do alvo
		local cf = head.CFrame * CFrame.new(0, 2.2, 0)
		myHrp.CFrame = cf
		myHrp.AssemblyLinearVelocity = Vector3.zero
		myHrp.AssemblyAngularVelocity = Vector3.zero
		beanPart.CFrame = cf * CFrame.Angles(0, tick() * 1.5, 0)
	end)

	local b = B:FindFirstChild("BeanHeadBtn")
