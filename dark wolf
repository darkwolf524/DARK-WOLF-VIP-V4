-- ========== BIG HEAD ==========
local bigHeadOn = false
local bigHeadScale = 3
local bigHeadOrig = nil

local function applyBigHead(char)
	if not char then return end
	local head = char:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then return end
	if not bigHeadOrig then
		bigHeadOrig = head.Size
	end
	pcall(function()
		head.Size = Vector3.new(
			bigHeadOrig.X * bigHeadScale,
			bigHeadOrig.Y * bigHeadScale,
			bigHeadOrig.Z * bigHeadScale
		)
		-- R6 mesh
		local mesh = head:FindFirstChildOfClass("SpecialMesh")
		if mesh then
			mesh.Scale = Vector3.new(bigHeadScale, bigHeadScale, bigHeadScale)
		end
		-- R15 / accessories: scale handles attached to head lightly
		for _, v in ipairs(char:GetChildren()) do
			if v:IsA("Accessory") then
				local handle = v:FindFirstChild("Handle")
				if handle and handle:IsA("BasePart") then
					local att = handle:FindFirstChildWhichIsA("Attachment")
					-- só cabeças / hats comuns à head
					if v.Name:lower():find("hat") or v.Name:lower():find("head") or v.AccessoryType == Enum.AccessoryType.Hat then
						pcall(function()
							handle.Size = handle.Size -- keep; mesh scale if any
							local sm = handle:FindFirstChildOfClass("SpecialMesh")
							if sm then sm.Scale = sm.Scale.Unit * bigHeadScale end
						end)
					end
				end
			end
		end
	end)
end

local function resetBigHead(char)
	char = char or P.Character
	if not char then return end
	local head = char:FindFirstChild("Head")
	if head and head:IsA("BasePart") and bigHeadOrig then
		pcall(function()
			head.Size = bigHeadOrig
			local mesh = head:FindFirstChildOfClass("SpecialMesh")
			if mesh then mesh.Scale = Vector3.new(1, 1, 1) end
		end)
	end
end

