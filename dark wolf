-- ========== CHAR (cliente — sem ApplyDescription de servidor) ==========
local function clearMyAppearance(char)
	for _, v in ipairs(char:GetChildren()) do
		if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic")
			or v:IsA("BodyColors") or v:IsA("CharacterMesh") then
			pcall(function() v:Destroy() end)
		end
	end
	local head = char:FindFirstChild("Head")
	if head then
		for _, d in ipairs(head:GetChildren()) do
			if d:IsA("Decal") and d.Name == "face" then
				pcall(function() d:Destroy() end)
			end
		end
	end
end

local function copyAppearanceFromCharacter(targetChar)
	local char = P.Character
	if not char or not targetChar then return false, "sem personagem" end
	clearMyAppearance(char)
	-- clona roupas / cores / acessórios do alvo online
	for _, v in ipairs(targetChar:GetChildren()) do
		if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic")
			or v:IsA("BodyColors") or v:IsA("CharacterMesh") then
			pcall(function()
				local cl = v:Clone()
				cl.Parent = char
			end)
		end
	end
	-- face
	local tHead = targetChar:FindFirstChild("Head")
	local myHead = char:FindFirstChild("Head")
	if tHead and myHead then
		for _, d in ipairs(tHead:GetChildren()) do
			if d:IsA("Decal") then
				pcall(function()
					local cl = d:Clone()
					cl.Parent = myHead
				end)
			end
		end
		if tHead:IsA("BasePart") and myHead:IsA("BasePart") then
			pcall(function() myHead.Color = tHead.Color end)
		end
	end
	-- cores do corpo (parts)
	for _, name in ipairs({"Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg",
		"UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand",
		"RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg",
		"LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"}) do
		local a = targetChar:FindFirstChild(name)
		local b = char:FindFirstChild(name)
		if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
			pcall(function()
				b.Color = a.Color
				b.Material = a.Material
			end)
		end
	end
	return true
end

local function applyDescriptionClient(desc)
	local char = P.Character
	if not char then return false, "sem personagem" end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return false, "sem humanoid" end
	-- tenta ApplyDescription (alguns executors liberam); se falhar, monta no cliente
	local ok = pcall(function()
		hum:ApplyDescription(desc)
	end)
	if ok then return true end
	ok = pcall(function()
		hum:ApplyDescriptionReset(desc)
	end)
	if ok then return true end

	clearMyAppearance(char)
	-- BodyColors
	pcall(function()
		local bc = Instance.new("BodyColors")
		bc.HeadColor3 = desc.HeadColor
		bc.TorsoColor3 = desc.TorsoColor
		bc.LeftArmColor3 = desc.LeftArmColor
		bc.RightArmColor3 = desc.RightArmColor
		bc.LeftLegColor3 = desc.LeftLegColor
		bc.RightLegColor3 = desc.RightLegColor
		bc.Parent = char
	end)
	-- Shirt / Pants / TShirt
	if desc.Shirt and desc.Shirt ~= 0 then
		pcall(function()
			local s = Instance.new("Shirt")
			s.ShirtTemplate = "rbxassetid://" .. tostring(desc.Shirt)
			s.Parent = char
		end)
	end
	if desc.Pants and desc.Pants ~= 0 then
		pcall(function()
			local s = Instance.new("Pants")
			s.PantsTemplate = "rbxassetid://" .. tostring(desc.Pants)
			s.Parent = char
		end)
	end
	if desc.GraphicTShirt and desc.GraphicTShirt ~= 0 then
		pcall(function()
			local s = Instance.new("ShirtGraphic")
			s.Graphic = "rbxassetid://" .. tostring(desc.GraphicTShirt)
			s.Parent = char
		end)
	end
	-- Face
	if desc.Face and desc.Face ~= 0 then
		pcall(function()
			local head = char:FindFirstChild("Head")
			if head then
				local face = head:FindFirstChild("face") or Instance.new("Decal")
				face.Name = "face"
				face.Texture = "rbxassetid://" .. tostring(desc.Face)
				face.Parent = head
			end
		end)
	end
	-- acessórios por ID (melhor esforço)
	local function addAccIds(str)
		if not str or str == "" then return end
		for id in string.gmatch(tostring(str), "%d+") do
			task.spawn(function()
				pcall(function()
					local asset = game:GetService("InsertService"):LoadAsset(tonumber(id))
					if asset then
						for _, obj in ipairs(asset:GetChildren()) do
							if obj:IsA("Accessory") then
								obj.Parent = char
							elseif obj:IsA("Model") then
								for _, a in ipairs(obj:GetChildren()) do
									if a:IsA("Accessory") then a.Parent = char end
								end
							end
						end
						asset:Destroy()
					end
				end)
			end)
		end
	end
	pcall(function()
		addAccIds(desc.HairAccessory)
		addAccIds(desc.HatAccessory)
		addAccIds(desc.FaceAccessory)
		addAccIds(desc.NeckAccessory)
		addAccIds(desc.ShouldersAccessory)
		addAccIds(desc.FrontAccessory)
		addAccIds(desc.BackAccessory)
		addAccIds(desc.WaistAccessory)
	end)
	return true
end

local function charFromUserId(userId)
	userId = tonumber(userId)
	if not userId then return false, "UserId inválido" end
	-- se o player estiver no jogo, copia o character (mais idêntico)
	for _, plr in ipairs(PL:GetPlayers()) do
		if plr.UserId == userId and plr.Character then
			return copyAppearanceFromCharacter(plr.Character)
		end
	end
	local desc
	local ok, err = pcall(function()
		desc = PL:GetHumanoidDescriptionFromUserIdAsync(userId)
	end)
	if not ok or not desc then
		return false, err or "não achou aparência"
	end
	return applyDescriptionClient(desc)
end

local function charFromUsername(name)
	name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if name == "" then return false, "digite o nick" end
	for _, plr in ipairs(PL:GetPlayers()) do
		if plr.Name:lower() == name:lower() or (plr.DisplayName and plr.DisplayName:lower() == name:lower()) then
			if plr.Character then
				return copyAppearanceFromCharacter(plr.Character)
			end
			return charFromUserId(plr.UserId)
		end
	end
	local userId
	local ok, err = pcall(function()
		userId = PL:GetUserIdFromNameAsync(name)
	end)
	if not ok or not userId then
		return false, "nick não encontrado: " .. name
	end
	return charFromUserId(userId)
end

