-- ========== VIEW (câmera no alvo) ==========
local viewOn = false
local viewTarget = nil
local viewConn = nil

local function stopView()
	viewOn = false
	viewTarget = nil
	if viewConn then
		viewConn:Disconnect()
		viewConn = nil
	end
	local cam = WS.CurrentCamera
	local hum = P.Character and P.Character:FindFirstChildOfClass("Humanoid")
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		if hum then
			cam.CameraSubject = hum
		end
	end
	local b = B:FindFirstChild("ViewBtn")
	if b then b.Text = "View: OFF" end
end

local function startView(plr)
	stopView()
	if not plr or not plr.Character or plr == P then return end
	local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
	local tPart = plr.Character:FindFirstChild("HumanoidRootPart")
		or plr.Character:FindFirstChild("Head")
	if not tHum and not tPart then return end

	viewOn = true
	viewTarget = plr
	local cam = WS.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		cam.CameraSubject = tHum or tPart
	end
	local b = B:FindFirstChild("ViewBtn")
	if b then b.Text = "View: " .. (plr.DisplayName or plr.Name) end

	-- mantém a câmera no alvo se respawnar / mudar
	viewConn = R.Heartbeat:Connect(function()
		if not viewOn or not viewTarget then
			stopView()
			return
		end
		local tChar = viewTarget.Character
		if not tChar then return end
		local hum = tChar:FindFirstChildOfClass("Humanoid")
		local part = tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Head")
		local cam = WS.CurrentCamera
		if cam and (hum or part) then
			cam.CameraSubject = hum or part
		end
	end)
end

