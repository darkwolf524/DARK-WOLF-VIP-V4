local function startFacePlayer(plr)
	stopFacePlayer()
	if not plr or not plr.Character or plr == P then return end
	local myChar = P.Character
	if not myChar then return end
	local myHRP = myChar:FindFirstChild("HumanoidRootPart")
	local myHum = myChar:FindFirstChildOfClass("Humanoid")
	local targetHRP = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Head")
	if not myHRP or not myHum or not targetHRP then return end

	local dist = 2.2
	local flatLook = Vector3.new(targetHRP.CFrame.LookVector.X, 0, targetHRP.CFrame.LookVector.Z)
	if flatLook.Magnitude < 0.05 then flatLook = Vector3.new(0, 0, -1) else flatLook = flatLook.Unit end
	local pos = targetHRP.Position + flatLook * dist
	pos = Vector3.new(pos.X, targetHRP.Position.Y, pos.Z)
	myHRP.CFrame = CFrame.new(pos, Vector3.new(targetHRP.Position.X, pos.Y, targetHRP.Position.Z))
	myHum.PlatformStand = true

	faceActive = true
	faceTarget = plr
	local b = B:FindFirstChild("FacePlayerBtn", true)
	if b then b.Text = "Face Player: ON" end

	local t0 = tick()
	local baseDist = dist

	faceConn = R.RenderStepped:Connect(function()
		if not faceActive or not faceTarget or not faceTarget.Character then
			stopFacePlayer()
			return
		end
		local th = faceTarget.Character:FindFirstChild("HumanoidRootPart") or faceTarget.Character:FindFirstChild("Head")
		local hrp = P.Character and P.Character:FindFirstChild("HumanoidRootPart")
		local hum = P.Character and P.Character:FindFirstChildOfClass("Humanoid")
		if not th or not hrp or not hum then
			stopFacePlayer()
			return
		end
		local flatLook = Vector3.new(th.CFrame.LookVector.X, 0, th.CFrame.LookVector.Z)
		if flatLook.Magnitude < 0.05 then
			flatLook = Vector3.new(0, 0, -1)
		else
			flatLook = flatLook.Unit
		end
		-- speed da caixa controla a frequência do vai-e-vem (ao vivo)
		local spd = tonumber(faceCfg.speed) or 6
		spd = math.clamp(spd, 0.5, 50)
		local amp = tonumber(faceCfg.amp) or 0.7
		local osc = math.sin((tick() - t0) * spd) * amp
		local desired = math.clamp(baseDist + osc, 1.1, baseDist + amp + 0.25)
		local newPos = th.Position + flatLook * desired
		newPos = Vector3.new(newPos.X, th.Position.Y, newPos.Z)
		hrp.CFrame = CFrame.new(newPos, Vector3.new(th.Position.X, newPos.Y, th.Position.Z))
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hum.PlatformStand = true
	end)
end

