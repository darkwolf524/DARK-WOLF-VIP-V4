-- ========== TP TOOL ==========
local tpTool = nil
local function giveTPTool()
	for _, bag in ipairs({P.Backpack, P.Character}) do
		if bag then
			for _, t in ipairs(bag:GetChildren()) do
				if t:IsA("Tool") and t.Name == "TP Tool" then t:Destroy() end
			end
		end
	end
	local tool = Instance.new("Tool")
	tool.Name = "TP Tool"
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.ToolTip = "Clique para teleportar"
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 0.3, 1.4)
	handle.Color = Color3.fromRGB(255, 200, 40)
	handle.Material = Enum.Material.Neon
	handle.Parent = tool
	tool.Activated:Connect(function()
		local cam = WS.CurrentCamera
		if not cam then return end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {P.Character}
		local hit = WS:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 2000, params)
		local hrp = P.Character and P.Character:FindFirstChild("HumanoidRootPart")
		if hrp and hit then
			hrp.CFrame = CFrame.new(hit.Position + hit.Normal * 3 + Vector3.new(0, 2, 0))
		elseif hrp then
			hrp.CFrame = CFrame.new(cam.CFrame.Position + cam.CFrame.LookVector * 80)
		end
	end)
	tool.Parent = P.Backpack
	tpTool = tool
	pcall(function()
		local hum = P.Character and P.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum:EquipTool(tool) end
	end)
end

btn("TP Tool", "TPToolBtn", function()
	giveTPTool()
end)

-- ========== HIT CIRCLE (círculo amarelo no avatar — alcance melee) ==========
local hitCircleOn = false
local hitCircleSize = 15
local hitCirclePart = nil
local hitCircleConn = nil

local function clearHitCircle()
	if hitCircleConn then hitCircleConn:Disconnect() hitCircleConn = nil end
	if hitCirclePart then pcall(function() hitCirclePart:Destroy() end) hitCirclePart = nil end
end

local function isMeleeEquipped()
	local char = P.Character
	if not char then return false end
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then
			local n = string.lower(t.Name)
			if n:find("knife") or n:find("sword") or n:find("blade") or n:find("faca") or n:find("espada")
				or n:find("dagger") or n:find("katana") or n:find("machete") or n:find("bat")
				or n:find("axe") or t:FindFirstChild("Handle") then
				return true, t
			end
		end
	end
	return false
end

local function startHitCircle()
	clearHitCircle()
	local char = P.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local s = math.clamp(tonumber(hitCircleSize) or 15, 3, 80)
	local p = Instance.new("Part")
	p.Name = "DW_HitCircle"
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(0.15, s * 2, s * 2)
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.Massless = true
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 210, 40)
	p.Transparency = 0.45
	p.Parent = char
	local w = Instance.new("Weld")
	w.Part0 = hrp
	w.Part1 = p
	w.C0 = CFrame.new(0, -2.8, 0) * CFrame.Angles(0, 0, math.rad(90))
	w.Parent = p
	hitCirclePart = p

	hitCircleConn = R.Heartbeat:Connect(function()
		if not hitCircleOn then return end
		local box = B:FindFirstChild("HitCircleSizeBox", true)
		if box then
			local v = tonumber(tostring(box.Text):gsub(",", "."))
			if v and v > 0 then hitCircleSize = math.clamp(v, 3, 80) end
		end
		local my = P.Character and P.Character:FindFirstChild("HumanoidRootPart")
		if not my or not hitCirclePart then return end
		local rad = math.clamp(tonumber(hitCircleSize) or 15, 3, 80)
		local want = Vector3.new(0.15, rad * 2, rad * 2)
		if (hitCirclePart.Size - want).Magnitude > 0.2 then
			hitCirclePart.Size = want
		end
		-- se tem faca/espada, "alcance" nos inimigos dentro do círculo
		local hasMelee = isMeleeEquipped()
		if not hasMelee then return end
		for _, plr in ipairs(PL:GetPlayers()) do
			if plr ~= P and plr.Character then
				local th = plr.Character:FindFirstChild("HumanoidRootPart")
				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				if th and hum and hum.Health > 0 then
					local dist = (th.Position - my.Position).Magnitude
					if dist <= rad then
						-- puxa um pouco o hitbox visual do inimigo pro alcance (client)
						pcall(function()
							-- tenta Activate tool em direção (jogos client-side)
							local tool = P.Character:FindFirstChildOfClass("Tool")
							if tool then
								pcall(function() tool:Activate() end)
							end
						end)
					end
				end
			end
		end
	end)
end

