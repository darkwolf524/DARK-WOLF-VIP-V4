local imitateOn = false
local imitateConn = nil
local imitateTarget = nil
local imitateTracks = {} -- [animId] = AnimationTrack local
local imitateSide = 3.5 -- distância ao lado

local function stopImitate()
	imitateOn = false
	imitateTarget = nil
	if imitateConn then
		imitateConn:Disconnect()
		imitateConn = nil
	end
	for id, tr in pairs(imitateTracks) do
		pcall(function()
			tr:Stop(0.1)
			tr:Destroy()
		end)
	end
	imitateTracks = {}
	local b = B:FindFirstChild("ImitateBtn")
	if b then b.Text = "Player Mimic: OFF" end
end

local function getAnimator(hum)
	if not hum then return nil end
	local a = hum:FindFirstChildOfClass("Animator")
	if not a then
		a = Instance.new("Animator")
		a.Parent = hum
	end
	return a
end

-- animações de locomoção padrão (não forçar R15 no R6)
local function isLocomotionTrack(track)
	local n = string.lower(tostring(track.Name or ""))
	if n:find("walk") or n:find("run") or n:find("sprint")
		or n:find("idle") or n:find("jump") or n:find("fall")
		or n:find("climb") or n:find("swim") or n:find("land") then
		return true
	end
	local p = track.Priority
	if p == Enum.AnimationPriority.Core or p == Enum.AnimationPriority.Idle then
		return true
	end
	if p == Enum.AnimationPriority.Movement then
		return true -- walk/run do humanoid: deixa o SEU rig tocar o próprio
	end
	return false
end

local function startImitate(plr)
	stopImitate()
	if not plr or not plr.Character then return end
	imitateOn = true
	imitateTarget = plr
	local b = B:FindFirstChild("ImitateBtn")
	if b then b.Text = "Player Mimic: " .. (plr.DisplayName or plr.Name) end

	imitateConn = R.Heartbeat:Connect(function()
		if not imitateOn or not imitateTarget then
			stopImitate()
			return
		end
		local tChar = imitateTarget.Character
		local myChar = P.Character
		if not tChar or not myChar then return end
		local tHum = tChar:FindFirstChildOfClass("Humanoid")
		local myHum = myChar:FindFirstChildOfClass("Humanoid")
		local tRoot = tChar:FindFirstChild("HumanoidRootPart")
		local myRoot = myChar:FindFirstChild("HumanoidRootPart")
		if not tHum or not myHum or not tRoot or not myRoot then return end
		if tHum.Health <= 0 or myHum.Health <= 0 then return end

		-- ao lado do alvo (R6 continua R6, R15 continua R15)
		local right = tRoot.CFrame.RightVector
		local sidePos = tRoot.Position + right * imitateSide
		local flatLook = Vector3.new(tRoot.CFrame.LookVector.X, 0, tRoot.CFrame.LookVector.Z)
		if flatLook.Magnitude < 0.05 then
			flatLook = Vector3.new(0, 0, -1)
		else
			flatLook = flatLook.Unit
		end

		-- só puxa a posição se afastou; senão o Humanoid anima andar normal
		local distSide = (Vector3.new(myRoot.Position.X, 0, myRoot.Position.Z)
			- Vector3.new(sidePos.X, 0, sidePos.Z)).Magnitude
		pcall(function()
			if distSide > 2.2 then
				myRoot.CFrame = CFrame.new(sidePos, sidePos + flatLook)
			else
				-- alinha olhando pra mesma direção, mantém Y
				local pos = Vector3.new(sidePos.X, myRoot.Position.Y, sidePos.Z)
				myRoot.CFrame = CFrame.new(pos, pos + flatLook)
			end
		end)

		-- movimento: SEU personagem anda/corre com a animação DELE (R6 ou R15)
		pcall(function()
			myHum.WalkSpeed = math.max(tHum.WalkSpeed, 1)
			if myHum.UseJumpPower then
				myHum.JumpPower = tHum.JumpPower
			else
				pcall(function() myHum.JumpHeight = tHum.JumpHeight end)
			end
			local md = tHum.MoveDirection
			if md.Magnitude > 0.05 then
				myHum:Move(md, false)
			else
				myHum:Move(Vector3.zero, false)
			end
			-- velocidade horizontal parecida (ajuda a acompanhar)
			local tv = tRoot.AssemblyLinearVelocity
			myRoot.AssemblyLinearVelocity = Vector3.new(tv.X, myRoot.AssemblyLinearVelocity.Y, tv.Z)
			if tHum.Jump or tHum:GetState() == Enum.HumanoidStateType.Jumping then
				myHum.Jump = true
			end
		end)

		-- danças / emotes (não locomoção) — tenta a mesma animação
		local tAnim = getAnimator(tHum)
		local myAnim = getAnimator(myHum)
		if not tAnim or not myAnim then return end

		local playing = {}
		pcall(function()
			for _, track in ipairs(tAnim:GetPlayingAnimationTracks()) do
				if isLocomotionTrack(track) then
					-- pula: R6 usa walk R6, R15 usa walk R15
				else
					local anim = track.Animation
					if anim and anim.AnimationId and anim.AnimationId ~= "" then
						local id = anim.AnimationId
						playing[id] = track
						if not imitateTracks[id] or not imitateTracks[id].IsPlaying then
							local a = Instance.new("Animation")
							a.AnimationId = id
							local ok, tr = pcall(function()
								return myAnim:LoadAnimation(a)
							end)
							if ok and tr then
								tr.Priority = track.Priority
								tr.Looped = track.Looped
								pcall(function()
									tr:Play(0.1, 1, track.Speed)
									tr.TimePosition = track.TimePosition
								end)
								imitateTracks[id] = tr
							end
						else
							local tr = imitateTracks[id]
							pcall(function()
								if math.abs(tr.TimePosition - track.TimePosition) > 0.35 then
									tr.TimePosition = track.TimePosition
								end
								tr:AdjustSpeed(track.Speed)
							end)
						end
					end
				end
			end
		end)

		for id, tr in pairs(imitateTracks) do
			if not playing[id] then
				pcall(function()
					tr:Stop(0.15)
					tr:Destroy()
				end)
				imitateTracks[id] = nil
			end
		end
	end)
end

