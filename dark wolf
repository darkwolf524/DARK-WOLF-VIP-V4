local function setCreeper(on)
	local c = P.Character
	if not c then return end
	clearCreeperHead()
	if not on then
		for v, data in pairs(creeperData) do
			if v and v.Parent then
				v.LocalTransparencyModifier = data.transparency or 0
			end
		end
		creeperData = {}
		return
	end
	creeperData = {}
	for _, v in ipairs(c:GetChildren()) do
		if v:IsA("BasePart") then
			local q = v.Name:lower()
			if q:find("arm") or q:find("hand") then
				creeperData[v] = {transparency = v.LocalTransparencyModifier}
				v.LocalTransparencyModifier = 1
			end
		end
	end
	local head = c:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		creeperData[head] = {transparency = head.LocalTransparencyModifier}
		head.LocalTransparencyModifier = 1
		local h = Instance.new("Part")
		h.Name = "DarkWolfCreeperHead"
		h.Size = Vector3.new(2, 2, 2)
		h.CFrame = head.CFrame
		h.Color = head.Color
		h.Material = head.Material
		h.CanCollide = false
		h.CanTouch = false
		h.CanQuery = false
		h.Massless = true
		h.CastShadow = false
		h.Parent = WS
		Instance.new("WeldConstraint", h).Part0 = h
		h.WeldConstraint.Part1 = head
		local face = head:FindFirstChildWhichIsA("Decal")
		if face then
			local d = face:Clone()
			d.Parent = h
			d.Face = face.Face
		end
	end
end

