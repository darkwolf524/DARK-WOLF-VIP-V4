local activityEvent = ReplicatedStorage:FindFirstChild("PlayerActivity")
local function getActivityEvent()
	local ev = ReplicatedStorage:FindFirstChild("PlayerActivity")
	if ev then return ev end
	local ok, res = pcall(function()
		return ReplicatedStorage:WaitForChild("PlayerActivity", 10)
	end)
	return ok and res or nil
end
activityEvent = activityEvent or getActivityEvent()

local lastPingSent, SEND_INTERVAL, activityInputConn, activityMoveConn = 0, 1.8, nil, nil
pingEnabled = false
local function sendPing()
	if not activityEvent then
		activityEvent = getActivityEvent()
		if not activityEvent then return end
	end
	if tick() - lastPingSent < SEND_INTERVAL then return end
	lastPingSent = tick()
	pcall(function()
		activityEvent:FireServer()
	end)
end
local function startActivityListeners()
	if activityInputConn or activityMoveConn then return end
	activityInputConn = UIS.InputBegan:Connect(function(i, p)
		if not p then sendPing() end
	end)
	local lastPos = nil
	activityMoveConn = RS.RenderStepped:Connect(function()
		local root = P.Character and (P.Character:FindFirstChild("HumanoidRootPart") or P.Character:FindFirstChild("Torso") or P.Character:FindFirstChild("UpperTorso"))
		if root then
			local pos = root.Position
			if lastPos and (pos - lastPos).Magnitude > .6 then sendPing() end
			lastPos = pos
		end
	end)
end
local function stopActivityListeners()
	if activityInputConn then activityInputConn:Disconnect() activityInputConn = nil end
	if activityMoveConn then activityMoveConn:Disconnect() activityMoveConn = nil end
end

