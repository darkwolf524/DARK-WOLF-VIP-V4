		if not current or not hrp.Parent then
			stopGlitch()
			return
		end
		local elapsed = tick() - t0
		local val = math.sin(elapsed * glitchSpeed) * .5
		local offset = Vector3.new(math.sin(elapsed * 12 * glitchSpeed) * .15, math.cos(elapsed * 9 * glitchSpeed) * .2, math.sin(elapsed * 7 * glitchSpeed) * .15)
