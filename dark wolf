local ragdollOn = false
local ragdollMotors = {}

local function setRagdoll(on)
	local char = P.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end
	if on then
		ragdollMotors = {}
		hum.PlatformStand = true
		hum.AutoRotate = false
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
		for _, m in ipairs(char:GetDescendants()) do
			if m:IsA("Motor6D") and m.Part0 and m.Part1 then
				local a0 = Instance.new("Attachment")
				a0.Name = "DW_RagA0"
				a0.Parent = m.Part0
				local a1 = Instance.new("Attachment")
				a1.Name = "DW_RagA1"
				a1.Parent = m.Part1
				a0.CFrame = m.C0
				a1.CFrame = m.C1
				local ball = Instance.new("BallSocketConstraint")
				ball.Name = "DW_RagBall"
				ball.Attachment0 = a0
				ball.Attachment1 = a1
				ball.LimitsEnabled = true
				ball.TwistLimitsEnabled = true
				ball.Parent = m.Part0
				table.insert(ragdollMotors, {motor = m, en = m.Enabled, a0 = a0, a1 = a1, ball = ball})
				m.Enabled = false
			end
		end
	else
		for _, data in ipairs(ragdollMotors) do
			pcall(function()
				if data.ball then data.ball:Destroy() end
				if data.a0 then data.a0:Destroy() end
				if data.a1 then data.a1:Destroy() end
				if data.motor then data.motor.Enabled = data.en ~= false end
			end)
		end
		ragdollMotors = {}
		hum.PlatformStand = false
		hum.AutoRotate = true
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
	end
end

