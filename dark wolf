local function startFpsCounter()
	stopFpsCounter()
	fpsGui = Instance.new("ScreenGui")
	fpsGui.Name = "DW_FPS"
	fpsGui.ResetOnSpawn = false
	fpsGui.IgnoreGuiInset = true
	fpsGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	pcall(function() fpsGui.Parent = game:GetService("CoreGui") end)
	if not fpsGui.Parent then
		fpsGui.Parent = P:WaitForChild("PlayerGui")
	end
	fpsLabel = Instance.new("TextLabel", fpsGui)
	fpsLabel.Name = "FPS"
	fpsLabel.Size = UDim2.new(0, 120, 0, 28)
	fpsLabel.Position = UDim2.new(1, -130, 0, 10)
	fpsLabel.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
	fpsLabel.BackgroundTransparency = 0.25
	fpsLabel.BorderSizePixel = 0
	fpsLabel.Font = Enum.Font.GothamBold
	fpsLabel.Text = "FPS: --"
	fpsLabel.TextColor3 = Color3.fromRGB(100, 255, 120)
	fpsLabel.TextSize = 14
	fpsLabel.TextXAlignment = Enum.TextXAlignment.Center
	corner(fpsLabel, 6)
	outline(fpsLabel, RED, 1)
	local frames = 0
	local last = tick()
	fpsConn = R.RenderStepped:Connect(function()
		frames += 1
		local now = tick()
		if now - last >= 0.5 then
			local fps = math.floor(frames / (now - last) + 0.5)
			if fpsLabel then
				fpsLabel.Text = "FPS: " .. tostring(fps)
				if fps >= 50 then
					fpsLabel.TextColor3 = Color3.fromRGB(100, 255, 120)
				elseif fps >= 30 then
					fpsLabel.TextColor3 = Color3.fromRGB(255, 210, 80)
				else
					fpsLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
				end
			end
