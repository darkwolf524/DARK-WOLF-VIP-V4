local rainbowMapOrig = {}

local function stopRainbowMap()
	rainbowMapOn = false
	if rainbowMapConn then rainbowMapConn:Disconnect() rainbowMapConn = nil end
	for part, col in pairs(rainbowMapOrig) do
		if part and part.Parent then
			pcall(function() part.Color = col end)
		end
	end
	rainbowMapOrig = {}
	local b = B:FindFirstChild("RainbowMapBtn")
	if b then b.Text = "Rainbow Map: OFF" end
end

local function startRainbowMap()
	stopRainbowMap()
	rainbowMapOn = true
	rainbowMapOrig = {}
	local count = 0
	for _, v in ipairs(WS:GetDescendants()) do
		if count > 400 then break end
		if v:IsA("BasePart") and not v:IsDescendantOf(P.Character or workspace) then
			local p = v.Parent
			if p and (p:IsA("Model") or p == WS or p:IsA("Folder")) then
				if not rainbowMapOrig[v] then
					rainbowMapOrig[v] = v.Color
					count += 1
				end
			end
		end
	end
	local t0 = tick()
	rainbowMapConn = R.Heartbeat:Connect(function()
		if not rainbowMapOn then return end
		local base = (tick() - t0) * 0.2
		local i = 0
		for part, _ in pairs(rainbowMapOrig) do
			if part and part.Parent then
				i += 1
				pcall(function()
					part.Color = Color3.fromHSV((base + i * 0.01) % 1, 0.85, 1)
				end)
			end
		end
	end)
	local b = B:FindFirstChild("RainbowMapBtn")
	if b then b.Text = "Rainbow Map: ON" end
end

