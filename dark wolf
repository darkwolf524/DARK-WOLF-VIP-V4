local function applyAccent(c)
	cfg.accent = c
	pcall(function()
		-- textos de destaque
		Sub.TextColor3 = c
		LeftNavTitle.TextColor3 = c
		if homeFooter then homeFooter.TextColor3 = c end
		-- barras e faixas
		TL.BackgroundColor3 = c
		-- borda do menu
		for _, v in ipairs(M:GetChildren()) do
