-- ========== SEARCH (hitbox azul na faca/espada) ==========
local searchOn = false
local searchSize = 10
local searchPart = nil
local searchConn = nil

local function isMeleeTool(tool)
	if not tool or not tool:IsA("Tool") then return false end
	local n = string.lower(tool.Name)
	-- não é arma de fogo
	if n:find("gun") or n:find("rifle") or n:find("pistol") or n:find("shot") or n:find("sniper") or n:find("bow") or n:find("crossbow") then
		return false
	end
	-- faca / espada / melee comum
	if n:find("knife") or n:find("sword") or n:find("blade") or n:find("faca") or n:find("espada")
		or n:find("dagger") or n:find("katana") or n:find("machete") or n:find("axe") or n:find("bat")
		or n:find("club") or n:find("melee") or n:find("saber") or n:find("scythe") then
		return true
	end
	-- se tem Handle e não parece arma de longo alcance, aceita
	if tool:FindFirstChild("Handle") and not tool:FindFirstChildWhichIsA("RemoteEvent") then
		return true
	end
	return tool:FindFirstChild("Handle") ~= nil
end

local function clearSearchPart()
	if searchPart then
		pcall(function() searchPart:Destroy() end)
		searchPart = nil
	end
end

local function attachSearchToTool(tool)
	clearSearchPart()
	if not tool then return end
	local handle = tool:FindFirstChild("Handle")
	if not handle or not handle:IsA("BasePart") then return end
	local s = math.clamp(tonumber(searchSize) or 10, 1, 80)
	-- retângulo AZUL na espada/faca (bem visível)
	local p = Instance.new("Part")
	p.Name = "DW_SearchHitbox"
	p.Size = Vector3.new(math.max(1.2, s * 0.25), math.max(0.6, s * 0.12), math.max(2, s))
	p.Color = Color3.fromRGB(0, 140, 255)
	p.Material = Enum.Material.SmoothPlastic
	p.Transparency = 0.35
	p.Reflectance = 0.1
	p.CanCollide = false
	p.CanTouch = true
	p.CanQuery = true
	p.Massless = true
	p.Anchored = false
	p.CastShadow = false
	p.Parent = tool
	-- fica na frente da lâmina
	local w = Instance.new("Weld")
	w.Part0 = handle
	w.Part1 = p
	w.C0 = CFrame.new(0, 0, -p.Size.Z * 0.45)
	w.Parent = p
	local sel = Instance.new("SelectionBox")
	sel.Adornee = p
	sel.LineThickness = 0.05
	sel.Color3 = Color3.fromRGB(0, 170, 255)
	sel.SurfaceColor3 = Color3.fromRGB(0, 140, 255)
	sel.SurfaceTransparency = 0.7
	sel.Parent = p
	searchPart = p
end

local function findMeleeInCharacter()
	local char = P.Character
	if not char then return nil end
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") and isMeleeTool(t) then
			return t
		end
	end
	return nil
end

local function startSearchLoop()
	if searchConn then return end
	searchConn = R.Heartbeat:Connect(function()
		if not searchOn then return end
		local box = B:FindFirstChild("SearchSizeBox", true)
		if box then
			local v = tonumber(tostring(box.Text):gsub(",", "."))
			if v and v > 0 then searchSize = math.clamp(v, 1, 80) end
		end
		local tool = findMeleeInCharacter()
		if tool then
			local s = math.clamp(tonumber(searchSize) or 10, 1, 80)
			if not searchPart or searchPart.Parent ~= tool then
				attachSearchToTool(tool)
			elseif searchPart then
				local want = Vector3.new(s * 0.35, s * 0.15, s)
				if (searchPart.Size - want).Magnitude > 0.1 then
					searchPart.Size = want
				end
			end
		else
			clearSearchPart()
		end
	end)
end

local function stopSearchLoop()
	if searchConn then
		searchConn:Disconnect()
		searchConn = nil
	end
	clearSearchPart()
end

