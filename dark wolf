local function drawLine(from, to)
	local dist = (to - from).Magnitude
	if dist < 1 then return end
	local mid = (from + to) / 2
	local angle = math.atan2(to.Y - from.Y, to.X - from.X)
	local line = Instance.new("Frame", LinesFolder)
	line.BackgroundColor3 = Color3.fromRGB(255, 200, 40)
	line.BorderSizePixel = 0
	line.AnchorPoint = Vector2.new(0.5, 0.5)
	line.Position = UDim2.new(0, mid.X, 0, mid.Y)
	line.Size = UDim2.new(0, dist, 0, 1.5)
	line.Rotation = math.deg(angle)
	line.BackgroundTransparency = 0.2
end

local function getTargetPart(model)
	if not model or not model:IsA("Model") then return nil end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	-- prioridade total na cabeça
	local head = model:FindFirstChild("Head")
	if head then return head end
	return model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("Torso")
end

local function isPlayerCharacter(model)
	for _, plr in ipairs(PL:GetPlayers()) do
		if plr.Character == model then return true, plr end
	end
	return false, nil
end

-- não mira em aliados (mesma Team / TeamColor)
local function isEnemy(plr)
	if not plr or plr == P then return false end
	local ok, sameTeam = pcall(function()
		if P.Team ~= nil and plr.Team ~= nil and P.Team == plr.Team then
			return true
		end
		if P.TeamColor and plr.TeamColor and P.TeamColor == plr.TeamColor then
			-- se os dois têm team color e é igual, trata como aliado
			if P.Team ~= nil or plr.Team ~= nil then
				return P.Team == plr.Team
			end
		end
		return false
	end)
	if ok and sameTeam then return false end
	return true
end

local function findClosestTarget(myHRP, cam)
	local center = cam and Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
	-- se o lock atual morreu / sumiu, limpa
	if aimbotLockedPart then
		local ok = false
		local model = aimbotLockedPart.Parent
		if model and model:IsA("Model") then
			local hum = model:FindFirstChildOfClass("Humanoid")
			local head = model:FindFirstChild("Head")
			local _, owner = isPlayerCharacter(model)
			if head and hum and hum.Health > 0 and owner and isEnemy(owner) then
				aimbotLockedPart = head
				ok = true
			end
		end
		if not ok then aimbotLockedPart = nil end
	end

	local closest, closestScore = nil, math.huge
	local function consider(head, forceSwitch)
		if not head then return end
		local dist = (myHRP.Position - head.Position).Magnitude
		if dist > 500 then return end
		if not cam or not center then return end
		local sp, onScreen = cam:WorldToViewportPoint(head.Position)
		if not onScreen or sp.Z <= 0 then return end
		local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
		if screenDist > FOV_RADIUS + 60 then return end
		-- prioridade: mais perto do centro da mira, depois distância 3D
		local score = screenDist * 2.5 + dist * 0.05
		if score < closestScore then
			closestScore = score
			closest = head
		end
	end

	for _, plr in ipairs(PL:GetPlayers()) do
		if plr ~= P and plr.Character and isEnemy(plr) then
			local head = plr.Character:FindFirstChild("Head")
			if head then consider(head) end
		end
	end

	-- troca de alvo: se outro inimigo estiver bem mais no centro da mira, troca
	if closest then
		if not aimbotLockedPart then
			aimbotLockedPart = closest
		else
			local spL = cam:WorldToViewportPoint(aimbotLockedPart.Position)
			local dL = (Vector2.new(spL.X, spL.Y) - center).Magnitude
			local spC = cam:WorldToViewportPoint(closest.Position)
			local dC = (Vector2.new(spC.X, spC.Y) - center).Magnitude
			-- se você virou pro outro (bem mais central) ou o atual saiu do FOV, troca
			if closest ~= aimbotLockedPart and (dC + 18 < dL or dL > FOV_RADIUS + 40) then
				aimbotLockedPart = closest
			end
		end
		return aimbotLockedPart
	end
	aimbotLockedPart = nil
	return nil
end

local function startAimbot()
	if aimbotConn then return end
	FovCircle.Visible = true
	aimbotLockedPart = nil
	-- Aimbot FORÇADO na cabeça do inimigo (sempre ativo enquanto ON)
	-- Troca de alvo: vira a câmera pra outro inimigo / quando o atual morre
	aimbotConn = R.RenderStepped:Connect(function()
		if not aimbot then return end
		local char, cam = P.Character, WS.CurrentCamera
		if not char or not cam then
			clearLines()
			return
		end
		local myHRP = char:FindFirstChild("HumanoidRootPart")
		if not myHRP then
			clearLines()
			return
		end

		local target = findClosestTarget(myHRP, cam)
		if target and target.Parent then
			-- mira 100% forçada no centro da cabeça
			local aimPos = target.Position
			cam.CFrame = CFrame.new(cam.CFrame.Position, aimPos)
		end

		clearLines()
		local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
		for _, plr in ipairs(PL:GetPlayers()) do
			if plr ~= P and plr.Character and isEnemy(plr) then
				local head = plr.Character:FindFirstChild("Head")
				if head then
					local pos, onScreen = cam:WorldToViewportPoint(head.Position)
					if onScreen and pos.Z > 0 then
						local screenPos = Vector2.new(pos.X, pos.Y)
						if (screenPos - center).Magnitude <= FOV_RADIUS + 50 then
							drawLine(center, screenPos)
						end
					end
				end
			end
		end
	end)
end

local function stopAimbot()
	if aimbotConn then
		aimbotConn:Disconnect()
		aimbotConn = nil
	end
	aimbotLockedPart = nil
	FovCircle.Visible = false
	clearLines()
end

