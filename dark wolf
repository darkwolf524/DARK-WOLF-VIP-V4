	if b then b.Text = bigHeadOn and "Big Head: ON" or "Big Head: OFF" end
	if bigHeadOn then
		if P.Character then
			bigHeadOrig = nil
			applyBigHead(P.Character)
		end
	else
		resetBigHead(P.Character)
		bigHeadOrig = nil
	end
end)

