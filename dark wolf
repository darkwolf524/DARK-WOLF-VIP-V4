-- ========== MUTE PLAYER (esconde chat do alvo no seu cliente) ==========
local mutedPlayers = {} -- [UserId] = true
local muteConn = nil

local function ensureMuteHook()
	if muteConn then return end
	-- Text Chat
	pcall(function()
		local chat = game:GetService("Chat")
		muteConn = true
	end)
	pcall(function()
		local sg = game:GetService("StarterGui")
		-- Legacy: filter bubble chat / text chat
	end)
	-- TextChatService (novo chat)
	pcall(function()
		local tcs = game:GetService("TextChatService")
		if tcs and tcs.MessageReceived then
			tcs.MessageReceived:Connect(function(msg)
				local ok, src = pcall(function()
					return msg.TextSource
				end)
				if ok and src and mutedPlayers[src.UserId] then
					pcall(function()
						msg.Text = ""
					end)
				end
			end)
		end
		if tcs and tcs.OnIncomingMessage then
			tcs.OnIncomingMessage = function(msg)
				local props = Instance.new("TextChatMessageProperties")
				local src = msg.TextSource
				if src and mutedPlayers[src.UserId] then
					props.Text = " "
					props.PrefixText = ""
				end
				return props
			end
		end
	end)
	-- DefaultChatSystemChatEvents
	pcall(function()
		local rs = game:GetService("ReplicatedStorage")
		local dcs = rs:FindFirstChild("DefaultChatSystemChatEvents")
		if dcs and dcs:FindFirstChild("OnMessageDoneFiltering") then
			dcs.OnMessageDoneFiltering.OnClientEvent:Connect(function(data)
				if type(data) ~= "table" then return end
				local name = data.FromSpeaker
				if not name then return end
				for _, plr in ipairs(PL:GetPlayers()) do
					if plr.Name == name and mutedPlayers[plr.UserId] then
						-- não tem como apagar remoto fácil; tenta esconder no GUI
						task.defer(function()
							pcall(function()
								local pg = P:FindFirstChild("PlayerGui")
								if not pg then return end
								for _, g in ipairs(pg:GetDescendants()) do
									if g:IsA("TextLabel") or g:IsA("TextButton") then
										local tx = tostring(g.Text or "")
										if tx:find(name, 1, true) and (#tx < 400) then
											if mutedPlayers[plr.UserId] then
												g.Text = ""
												g.Visible = false
											end
										end
									end
								end
							end)
						end)
						break
					end
				end
			end)
		end
	end)
	-- esconde bubble chat do muted
	R.Heartbeat:Connect(function()
		for _, plr in ipairs(PL:GetPlayers()) do
			if mutedPlayers[plr.UserId] and plr.Character then
				local head = plr.Character:FindFirstChild("Head")
				if head then
					for _, ch in ipairs(head:GetChildren()) do
						if ch:IsA("BillboardGui") or ch.Name:lower():find("bubble") then
							pcall(function() ch:Destroy() end)
						end
					end
				end
			end
		end
	end)
end

local function toggleMute(plr)
	if not plr or plr == P then return end
	ensureMuteHook()
	if mutedPlayers[plr.UserId] then
		mutedPlayers[plr.UserId] = nil
	else
		mutedPlayers[plr.UserId] = true
	end
end

btn("Mute Player", "MutePlayerBtn", function()
	if makeTrollSelectMenu then
		makeTrollSelectMenu(function(plr)
