local beanSaved = {}

local function stopBeanHead()
	beanOn = false
	beanTarget = nil
	if beanConn then
		beanConn:Disconnect()
		beanConn = nil
	end
	if beanPart then
		pcall(function() beanPart:Destroy() end)
		beanPart = nil
	end
	local char = P.Character
	if char then
		for part, data in pairs(beanSaved) do
			if part and part.Parent then
				pcall(function()
					if part:IsA("BasePart") then
						part.LocalTransparencyModifier = data.trans or 0
						part.CanCollide = data.collide ~= false
					elseif part:IsA("Decal") then
						part.Transparency = data.trans or 0
					end
				end)
			end
		end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = false
			hum.AutoRotate = true
		end
	end
	beanSaved = {}
	local b = B:FindFirstChild("BeanHeadBtn")
	if b then b.Text = "Bean Head: OFF" end
end

local function startBeanHead(plr)
	stopBeanHead()
	if not plr or not plr.Character then return end
