local faceActive, faceTarget, faceConn = false, nil, nil
-- tabela pra velocidade sempre atualizar no loop (closure)
local faceCfg = { speed = 6, amp = 0.7 }

local function stopFacePlayer()
	if faceConn then faceConn:Disconnect() faceConn = nil end
	faceActive = false
	faceTarget = nil
	local hum = P.Character and P.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = false
