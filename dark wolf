	ragdollOn = not ragdollOn
	local b = B:FindFirstChild("RagdollBtn")
	if b then b.Text = ragdollOn and "Ragdoll: ON" or "Ragdoll: OFF" end
	setRagdoll(ragdollOn)
end)

-- DISCOMOD
local discoOn = false
local discoConn = nil
local discoBackup = nil

local function stopDisco()
	discoOn = false
	if discoConn then discoConn:Disconnect() discoConn = nil end
	local L = game:GetService("Lighting")
	if discoBackup then
		pcall(function()
			L.Ambient = discoBackup.Ambient
			L.OutdoorAmbient = discoBackup.OutdoorAmbient
			L.Brightness = discoBackup.Brightness
			L.ClockTime = discoBackup.ClockTime
			local cc = L:FindFirstChild("DW_DiscoCC")
			if cc then cc:Destroy() end
		end)
		discoBackup = nil
	end
	local b = B:FindFirstChild("DiscoBtn")
	if b then b.Text = "Discomod: OFF" end
end

local function startDisco()
	stopDisco()
	discoOn = true
	local L = game:GetService("Lighting")
	discoBackup = {
		Ambient = L.Ambient,
		OutdoorAmbient = L.OutdoorAmbient,
		Brightness = L.Brightness,
		ClockTime = L.ClockTime,
	}
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "DW_DiscoCC"
	cc.Parent = L
	local t0 = tick()
	discoConn = R.RenderStepped:Connect(function()
		if not discoOn then return end
		local h = (tick() - t0) * 0.35 % 1
