local hitboxConn = nil

local function clearHitboxes()
	for _, v in ipairs(hitboxFolder:GetChildren()) do
		pcall(function() v:Destroy() end)
	end
end

local function makePlayerHitbox(plr)
	if not plr or plr == P or not plr.Character then return end
	local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
	local hum = plr.Character:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end
	local old = hitboxFolder:FindFirstChild("HB_" .. plr.UserId)
	if old then old:Destroy() end
	local s = math.clamp(tonumber(hitboxSize) or 8, 1, 50)
	local part = Instance.new("Part")
	part.Name = "HB_" .. plr.UserId
	part.Size = Vector3.new(s, s, s)
	part.Transparency = 0.55
	part.Color = Color3.fromRGB(255, 200, 40)
	part.Material = Enum.Material.ForceField
	part.CanCollide = false
	part.CanQuery = true
	part.CanTouch = true
	part.Massless = true
	part.Anchored = false
	part.CFrame = hrp.CFrame
	part.Parent = hitboxFolder
	local w = Instance.new("WeldConstraint")
	w.Part0 = part
	w.Part1 = hrp
	w.Parent = part
end

local function refreshHitboxes()
	clearHitboxes()
	if not hitboxOn then return end
	for _, plr in ipairs(PL:GetPlayers()) do
		if plr ~= P then makePlayerHitbox(plr) end
	end
end

local function startHitboxLoop()
	if hitboxConn then return end
	hitboxConn = R.Heartbeat:Connect(function()
		if not hitboxOn then return end
		local box = B:FindFirstChild("HitboxSizeBox", true)
		if box then
			local v = tonumber(tostring(box.Text):gsub(",", "."))
			if v and v > 0 then hitboxSize = math.clamp(v, 1, 50) end
		end
		for _, plr in ipairs(PL:GetPlayers()) do
			if plr ~= P and plr.Character then
				local part = hitboxFolder:FindFirstChild("HB_" .. plr.UserId)
				local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				if not hrp or not hum or hum.Health <= 0 then
					if part then part:Destroy() end
				else
					local s = math.clamp(tonumber(hitboxSize) or 8, 1, 50)
					if not part then
						makePlayerHitbox(plr)
					else
						if math.abs(part.Size.X - s) > 0.05 then
							part.Size = Vector3.new(s, s, s)
						end
					end
				end
			end
		end
	end)
end

local function stopHitboxLoop()
	if hitboxConn then
		hitboxConn:Disconnect()
		hitboxConn = nil
	end
	clearHitboxes()
end

