			local on = mutedPlayers[plr.UserId] == true
			pcall(function()
				game:GetService("StarterGui"):SetCore("SendNotification", {
					Title = "DARK WOLF";
					Text = (on and "Mutado: " or "Desmutado: ") .. plr.Name;
					Duration = 3;
				})
			end)
		end, false)
	end
end)


-- ========== KILL (precisa faca/espada) ==========
local killBusy = false

local function hasMeleeWeapon()
	local char = P.Character
	if not char then return false, nil end
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then
			local n = string.lower(t.Name)
			if n:find("knife") or n:find("sword") or n:find("blade") or n:find("faca") or n:find("espada")
				or n:find("dagger") or n:find("katana") or n:find("machete") or n:find("bat")
				or n:find("axe") or n:find("slash") or t:FindFirstChild("Handle") then
				return true, t
			end
		end
	end
	return false, nil
end

local function tryKillPlayer(plr)
	if not plr or plr == P or not plr.Character then return end
	local has, tool = hasMeleeWeapon()
	if not has or not tool then return false end
	local th = plr.Character:FindFirstChild("HumanoidRootPart")
	local hum = plr.Character:FindFirstChildOfClass("Humanoid")
	local my = P.Character and P.Character:FindFirstChild("HumanoidRootPart")
	if not th or not hum or not my or hum.Health <= 0 then return end
	pcall(function()
		-- chega perto e ativa a arma
		my.CFrame = th.CFrame * CFrame.new(0, 0, 2)
		local myHum = P.Character:FindFirstChildOfClass("Humanoid")
		if myHum then
			pcall(function() myHum:EquipTool(tool) end)
		end
		for _ = 1, 8 do
			pcall(function() tool:Activate() end)
			pcall(function()
				hum:TakeDamage(25)
			end)
			pcall(function()
				hum.Health = math.max(0, hum.Health - 25)
			end)
			task.wait(0.05)
		end
	end)
	return true
end

local function killNotify(msg)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "DARK WOLF";
			Text = msg;
			Duration = 3;
		})
	end)
end

btn("Kill Player", "KillPlayerBtn", function()
	local has = hasMeleeWeapon()
	if not has then
		killNotify("Segure uma faca/espada na mão!")
		return
	end
	if makeTrollSelectMenu then
		makeTrollSelectMenu(function(plr)
			if killBusy then return end
			killBusy = true
			tryKillPlayer(plr)
			killBusy = false
		end, false)
	end
end)

btn("Kill All", "KillAllBtn", function()
	local has = hasMeleeWeapon()
	if not has then
		killNotify("Segure uma faca/espada na mão!")
		return
	end
	if killBusy then return end
	killBusy = true
	task.spawn(function()
		for _, plr in ipairs(PL:GetPlayers()) do
			if plr ~= P then
				tryKillPlayer(plr)
				task.wait(0.15)
			end
		end
		killBusy = false
		killNotify("Kill All finalizado")
	end)
end)

