local bangActive, bangTarget, bangConn, bangSpeed, bangAmp, retreatBack, approachTime, bangOrig = false, nil, nil, 6, .6, 2.4, .18, {}
local function stopBang()
	if bangConn then bangConn:Disconnect() bangConn = nil end
	bangActive = false
	bangTarget = nil
	if P.Character then
		local hrp = P.Character:FindFirstChild("HumanoidRootPart")
		local hum = P.Character:FindFirstChildOfClass("Humanoid")
		if hum and bangOrig.humProps then
			pcall(function()
				hum.WalkSpeed = bangOrig.humProps.WalkSpeed or 16
				hum.PlatformStand = bangOrig.humProps.PlatformStand or false
			end)
		end
		if hrp and bangOrig.hrpprops then
			pcall(function()
				hrp.CanCollide = bangOrig.hrpprops.CanCollide
				hrp.AssemblyLinearVelocity = Vector3.zero
			end)
		end
	end
	bangOrig = {}
end

local function smoothMovePartTo(part, targetCFrame, duration)
	local ok, TSs = pcall(function()
		return game:GetService("TweenService")
	end)
	if not ok or not TSs then
		pcall(function()
			part.CFrame = targetCFrame
		end)
		return
	end
	local info = TweenInfo.new(math.max(.01, duration), Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local success, tw = pcall(function()
		return TSs:Create(part, info, {CFrame = targetCFrame})
	end)
	if success and tw then
		tw:Play()
		tw.Completed:Wait()
	else
		pcall(function()
			part.CFrame = targetCFrame
		end)
	end
end

local function halfDepth(part)
	return part and part:IsA("BasePart") and part.Size and part.Size.Z * .5 or .5
end

local function startBangOn(plr)
	stopBang()
	if not plr or not plr.Character or not P.Character then return end
	local targetRoot = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Head")
	local myHr = P.Character:FindFirstChild("HumanoidRootPart")
	local myHum = P.Character:FindFirstChildOfClass("Humanoid")
	if not targetRoot or not myHr or not myHum then return end
	bangOrig.humProps = {WalkSpeed = myHum.WalkSpeed, PlatformStand = myHum.PlatformStand}
	bangOrig.hrpprops = {CanCollide = myHr.CanCollide}
	pcall(function()
		myHum.WalkSpeed = 0
		myHum.PlatformStand = true
		myHr.CanCollide = false
		myHr.AssemblyLinearVelocity = Vector3.zero
	end)
	local baseDist = halfDepth(targetRoot) + halfDepth(myHr)
	local dir = targetRoot.CFrame.LookVector
	pcall(function()
		myHr.CFrame = CFrame.new(targetRoot.Position - dir * (baseDist + retreatBack), targetRoot.Position)
	end)
	smoothMovePartTo(myHr, CFrame.new(targetRoot.Position - dir * baseDist, targetRoot.Position), approachTime)
	task.wait(.02)
	bangActive = true
	bangTarget = plr
	local t0 = tick()
	bangConn = RS.RenderStepped:Connect(function()
		if not bangActive or not bangTarget or not bangTarget.Character then
			stopBang()
			return
		end
		local root = bangTarget.Character:FindFirstChild("HumanoidRootPart") or bangTarget.Character:FindFirstChild("Head")
		if not root then
			stopBang()
			return
		end
		local baseDist2 = halfDepth(root) + halfDepth(myHr)
		local osc = math.sin((tick() - t0) * bangSpeed) * bangAmp
		local desiredDist = math.clamp(baseDist2 + osc, math.max(0, baseDist2 - .02), baseDist2 + bangAmp)
		pcall(function()
			myHr.CFrame = CFrame.new(root.Position - root.CFrame.LookVector * desiredDist, root.Position)
			myHr.AssemblyLinearVelocity = Vector3.zero
		end)
	end)
end

