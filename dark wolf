local function openIADarkWolf()
	if iaGui and iaGui.Parent then
		iaGui.Enabled = true
		return
	end
	iaGui = Instance.new("ScreenGui")
	iaGui.Name = "DW_IA_DarkWolf"
	iaGui.ResetOnSpawn = false
	iaGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	pcall(function() iaGui.Parent = game:GetService("CoreGui") end)
	if not iaGui.Parent then iaGui.Parent = P:WaitForChild("PlayerGui") end

	local frame = Instance.new("Frame", iaGui)
	frame.Size = UDim2.new(0, 340, 0, 420)
	frame.Position = UDim2.new(0.5, -170, 0.5, -210)
	frame.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
	frame.BorderSizePixel = 0
	frame.Active = true
	frame.Draggable = true
	frame.BackgroundTransparency = 1
	corner(frame, 10)
	outline(frame, RED, 1)
	-- animação de abertura
	frame.Size = UDim2.new(0, 320, 0, 400)
	TS:Create(frame, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 340, 0, 420),
		BackgroundTransparency = 0,
	}):Play()

	local title = Instance.new("TextLabel", frame)
	title.Size = UDim2.new(1, -80, 0, 36)
	title.Position = UDim2.new(0, 12, 0, 6)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.Text = "IA Dark Wolf"
	title.TextColor3 = WHITE
	title.TextSize = 16
	title.TextXAlignment = Enum.TextXAlignment.Left

	local close = Instance.new("TextButton", frame)
	close.Size = UDim2.new(0, 28, 0, 28)
	close.Position = UDim2.new(1, -34, 0, 8)
	close.BackgroundColor3 = RED2
	close.BorderSizePixel = 0
	close.Font = Enum.Font.GothamBold
	close.Text = "X"
	close.TextColor3 = WHITE
	close.TextSize = 14
	corner(close, 6)
	close.MouseButton1Click:Connect(function()
		iaGui.Enabled = false
	end)

	local scroll = Instance.new("ScrollingFrame", frame)
	scroll.Name = "ChatScroll"
	scroll.Size = UDim2.new(1, -20, 1, -140)
	scroll.Position = UDim2.new(0, 10, 0, 44)
	scroll.BackgroundColor3 = Color3.fromRGB(8, 8, 12)
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	corner(scroll, 8)
	local list = Instance.new("UIListLayout", scroll)
	list.Padding = UDim.new(0, 6)
	list.SortOrder = Enum.SortOrder.LayoutOrder

	local function refreshCanvas()
		task.defer(function()
			scroll.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 12)
			scroll.CanvasPosition = Vector2.new(0, math.max(0, list.AbsoluteContentSize.Y))
		end)
	end
	list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshCanvas)

	local function addBubble(role, text)
		local wrap = Instance.new("Frame", scroll)
		wrap.Size = UDim2.new(1, -12, 0, 0)
		wrap.AutomaticSize = Enum.AutomaticSize.Y
		wrap.BackgroundTransparency = 1
		local wlay = Instance.new("UIListLayout", wrap)
		wlay.SortOrder = Enum.SortOrder.LayoutOrder
		wlay.Padding = UDim.new(0, 4)
		local bubble = Instance.new("TextLabel", wrap)
		bubble.Size = UDim2.new(1, 0, 0, 0)
		bubble.BackgroundColor3 = role == "user" and Color3.fromRGB(40, 18, 22) or CARD
		bubble.BorderSizePixel = 0
		bubble.Font = Enum.Font.Gotham
		bubble.Text = (role == "user" and "Você: " or "IA: ") .. tostring(text)
		bubble.TextColor3 = WHITE
		bubble.TextSize = 13
		bubble.TextWrapped = true
		bubble.TextXAlignment = Enum.TextXAlignment.Left
		bubble.TextYAlignment = Enum.TextYAlignment.Top
		bubble.AutomaticSize = Enum.AutomaticSize.Y
		bubble.BackgroundTransparency = 1
		bubble.TextTransparency = 1
		corner(bubble, 6)
		local pad = Instance.new("UIPadding", bubble)
		pad.PaddingTop = UDim.new(0, 6)
		pad.PaddingBottom = UDim.new(0, 6)
		pad.PaddingLeft = UDim.new(0, 8)
		pad.PaddingRight = UDim.new(0, 8)
		TS:Create(bubble, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundTransparency = 0,
			TextTransparency = 0,
		}):Play()
		if role == "ia" then
			local actions = Instance.new("Frame", wrap)
			actions.Size = UDim2.new(1, 0, 0, 26)
			actions.BackgroundTransparency = 1
			local layA = Instance.new("UIListLayout", actions)
			layA.FillDirection = Enum.FillDirection.Horizontal
			layA.Padding = UDim.new(0, 6)
			layA.VerticalAlignment = Enum.VerticalAlignment.Center
			local function smallBtn(label)
				local b = Instance.new("TextButton", actions)
				b.Size = UDim2.new(0, 64, 0, 22)
				b.BackgroundColor3 = Color3.fromRGB(28, 26, 34)
				b.BorderSizePixel = 0
				b.Font = Enum.Font.GothamSemibold
				b.Text = label
				b.TextColor3 = Color3.fromRGB(210, 210, 220)
				b.TextSize = 11
				corner(b, 5)
				return b
			end
			local copyB = smallBtn("Copiar")
			copyB.MouseButton1Click:Connect(function()
				pcall(function()
					if setclipboard then setclipboard(tostring(text)) end
				end)
				copyB.Text = "OK"
				task.delay(0.8, function() if copyB.Parent then copyB.Text = "Copiar" end end)
			end)
			local likeB = smallBtn("Like")
			local dislikeB = smallBtn("Dislike")
			likeB.MouseButton1Click:Connect(function()
				likeB.Text = "Liked"
				likeB.TextColor3 = Color3.fromRGB(100, 220, 120)
				dislikeB.Text = "Dislike"
				dislikeB.TextColor3 = Color3.fromRGB(210, 210, 220)
			end)
			dislikeB.MouseButton1Click:Connect(function()
				dislikeB.Text = "Disliked"
				dislikeB.TextColor3 = Color3.fromRGB(240, 100, 100)
				likeB.Text = "Like"
				likeB.TextColor3 = Color3.fromRGB(210, 210, 220)
			end)
		end
		table.insert(iaCurrent, { role = role, text = text })
		refreshCanvas()
	end

	local function clearChatVisual()
		for _, ch in ipairs(scroll:GetChildren()) do
			if ch:IsA("TextLabel") or ch:IsA("Frame") then ch:Destroy() end
		end
	end

	local function archiveCurrentIfAny()
		if #iaCurrent == 0 then return end
		local titleStr = "Bate-papo " .. (#iaSaved + 1)
		for _, m in ipairs(iaCurrent) do
			if m.role == "user" then
				titleStr = string.sub(m.text, 1, 28)
				break
			end
		end
		local copy = {}
		for _, m in ipairs(iaCurrent) do
			table.insert(copy, { role = m.role, text = m.text })
		end
		table.insert(iaSaved, { title = titleStr, msgs = copy })
	end

