-- ========== XRAY ==========
local xrayOn = false
local xrayOrig = {} -- [part] = original Transparency

local function isCharacterPart(part)
	local model = part:FindFirstAncestorOfClass("Model")
	if not model then return false end
	if model:FindFirstChildOfClass("Humanoid") then return true end
	return false
end

local function setXray(on)
	xrayOn = on
	if on then
		local count = 0
		for _, v in ipairs(WS:GetChildren()) do
			if count > 400 then break end
			if v:IsA("BasePart") and not isCharacterPart(v) then
				if xrayOrig[v] == nil then xrayOrig[v] = v.LocalTransparencyModifier end
				pcall(function() v.LocalTransparencyModifier = 0.7 end)
				count += 1
			elseif v:IsA("Model") and not v:FindFirstChildOfClass("Humanoid") then
				for _, p in ipairs(v:GetChildren()) do
					if count > 400 then break end
					if p:IsA("BasePart") then
						if xrayOrig[p] == nil then xrayOrig[p] = p.LocalTransparencyModifier end
						pcall(function() p.LocalTransparencyModifier = 0.7 end)
						count += 1
					end
				end
			elseif v:IsA("Folder") or v:IsA("Model") then
				for _, p in ipairs(v:GetDescendants()) do
					if count > 400 then break end
					if p:IsA("BasePart") and not isCharacterPart(p) then
						if xrayOrig[p] == nil then xrayOrig[p] = p.LocalTransparencyModifier end
						pcall(function() p.LocalTransparencyModifier = 0.7 end)
						count += 1
					end
				end
			end
		end
	else
		for part, orig in pairs(xrayOrig) do
			if part and part.Parent then
				pcall(function() part.LocalTransparencyModifier = orig end)
			end
		end
		xrayOrig = {}
	end
	local b = B:FindFirstChild("XRayBtn")
	if b then b.Text = xrayOn and "XRay: ON" or "XRay: OFF" end
end

btn("XRay: OFF", "XRayBtn", function()
	setXray(not xrayOn)
end)

