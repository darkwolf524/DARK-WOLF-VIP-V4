-- GIANT / TINY (salva original e restaura no OFF)
local sizeMod = "off" -- "giant" | "tiny" | "off"
local sizeOrig = nil -- {char=, scales={}, modelScale=, hip=}

local SIZE_NAMES = {"BodyDepthScale", "BodyHeightScale", "BodyWidthScale", "HeadScale", "BodyProportionScale", "BodyTypeScale"}

local function captureSizeOrig(char, hum)
	if sizeOrig and sizeOrig.char == char then return end
	local scales = {}
	for _, name in ipairs(SIZE_NAMES) do
		local v = hum:FindFirstChild(name)
		if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
			scales[name] = v.Value
		end
	end
	local modelScale = 1
	pcall(function()
		if char.GetScale then modelScale = char:GetScale() end
	end)
	sizeOrig = {
		char = char,
		scales = scales,
		modelScale = modelScale,
		hip = hum.HipHeight,
	}
end

local function restoreCharSize()
	local char = P.Character
	if not char or not sizeOrig or sizeOrig.char ~= char then
		sizeMod = "off"
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local hasR15 = false
	for name, val in pairs(sizeOrig.scales) do
		local v = hum:FindFirstChild(name)
		if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
			pcall(function() v.Value = val end)
			hasR15 = true
		end
	end
	pcall(function()
		hum.HipHeight = sizeOrig.hip or hum.HipHeight
	end)
	if not hasR15 then
		pcall(function()
			if char.ScaleTo then
				char:ScaleTo(sizeOrig.modelScale or 1)
			end
		end)
	end
	-- limpa atributos antigos de size bugado
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part:GetAttribute("DW_BaseSize") ~= nil then
			pcall(function() part:SetAttribute("DW_BaseSize", nil) end)
		end
	end
	sizeMod = "off"
end

local function applyCharSize(mult)
	local char = P.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	captureSizeOrig(char, hum)
	local hasR15 = false
	for name, base in pairs(sizeOrig.scales) do
		local v = hum:FindFirstChild(name)
		if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
			pcall(function() v.Value = base * mult end)
			hasR15 = true
		end
	end
	if hasR15 then
		pcall(function()
			hum.HipHeight = (sizeOrig.hip or 2) * mult
		end)
	else
		-- só ScaleTo (não mexe Size das parts — isso bugava o corpo)
		pcall(function()
			if char.ScaleTo then
				char:ScaleTo((sizeOrig.modelScale or 1) * mult)
			end
		end)
	end
end

