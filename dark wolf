	x.Size = UDim2.new(.42, -8, 0, 32)
	x.BackgroundColor3 = Color3.fromRGB(8, 9, 14)
	x.BorderSizePixel = 0
	x.Font = Enum.Font.GothamBold
	x.Text = tostring(faceCfg.speed)
	x.PlaceholderText = "Speed"
	x.TextColor3 = RED
	x.TextSize = 14
	x.ClearTextOnFocus = false
	x.TextXAlignment = Enum.TextXAlignment.Center
	corner(x, 7)
	outline(x, Color3.fromRGB(80, 80, 85), 1)
	local function applyFaceSpeed()
		local raw = tostring(x.Text):gsub(",", "."):gsub("%s", "")
		local v = tonumber(raw)
		if v and v > 0 then
			v = math.clamp(v, 0.5, 50)
			faceCfg.speed = v
			faceCfg.amp = math.clamp(0.45 + v * 0.04, 0.45, 1.4)
			x.Text = tostring(v)
		else
			x.Text = tostring(faceCfg.speed)
		end
	end
	-- só aplica ao apertar Enter (não enquanto digita / não ao clicar fora)
	x.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			applyFaceSpeed()
		else
			x.Text = tostring(faceCfg.speed)
		end
	end)
end

-- ========== IMITAR JOGADOR (movimento + animação R6/R15) ==========
local imitateOn = false
local imitateConn = nil
local imitateTarget = nil
local imitateTracks = {} -- [animId] = AnimationTrack local
local imitateSide = 3.5 -- distância ao lado

local function stopImitate()
	imitateOn = false
	imitateTarget = nil
	if imitateConn then
		imitateConn:Disconnect()
		imitateConn = nil
	end
	for id, tr in pairs(imitateTracks) do
		pcall(function()
			tr:Stop(0.1)
			tr:Destroy()
		end)
	end
	imitateTracks = {}
	local b = B:FindFirstChild("ImitateBtn")
	if b then b.Text = "Player Mimic: OFF" end
end

local function getAnimator(hum)
	if not hum then return nil end
	local a = hum:FindFirstChildOfClass("Animator")
	if not a then
		a = Instance.new("Animator")
		a.Parent = hum
	end
	return a
end

-- animações de locomoção padrão (não forçar R15 no R6)
local function isLocomotionTrack(track)
	local n = string.lower(tostring(track.Name or ""))
	if n:find("walk") or n:find("run") or n:find("sprint")
		or n:find("idle") or n:find("jump") or n:find("fall")
		or n:find("climb") or n:find("swim") or n:find("land") then
		return true
	end
	local p = track.Priority
	if p == Enum.AnimationPriority.Core or p == Enum.AnimationPriority.Idle then
		return true
	end
	if p == Enum.AnimationPriority.Movement then
		return true -- walk/run do humanoid: deixa o SEU rig tocar o próprio
	end
	return false
end

local function startImitate(plr)
	stopImitate()
	if not plr or not plr.Character then return end
	imitateOn = true
	imitateTarget = plr
	local b = B:FindFirstChild("ImitateBtn")
	if b then b.Text = "Player Mimic: " .. (plr.DisplayName or plr.Name) end

	imitateConn = R.Heartbeat:Connect(function()
		if not imitateOn or not imitateTarget then
			stopImitate()
			return
		end
		local tChar = imitateTarget.Character
		local myChar = P.Character
		if not tChar or not myChar then return end
		local tHum = tChar:FindFirstChildOfClass("Humanoid")
		local myHum = myChar:FindFirstChildOfClass("Humanoid")
		local tRoot = tChar:FindFirstChild("HumanoidRootPart")
		local myRoot = myChar:FindFirstChild("HumanoidRootPart")
		if not tHum or not myHum or not tRoot or not myRoot then return end
		if tHum.Health <= 0 or myHum.Health <= 0 then return end

		-- ao lado do alvo (R6 continua R6, R15 continua R15)
		local right = tRoot.CFrame.RightVector
		local sidePos = tRoot.Position + right * imitateSide
		local flatLook = Vector3.new(tRoot.CFrame.LookVector.X, 0, tRoot.CFrame.LookVector.Z)
		if flatLook.Magnitude < 0.05 then
			flatLook = Vector3.new(0, 0, -1)
		else
			flatLook = flatLook.Unit
		end

		-- só puxa a posição se afastou; senão o Humanoid anima andar normal
		local distSide = (Vector3.new(myRoot.Position.X, 0, myRoot.Position.Z)
			- Vector3.new(sidePos.X, 0, sidePos.Z)).Magnitude
		pcall(function()
			if distSide > 2.2 then
				myRoot.CFrame = CFrame.new(sidePos, sidePos + flatLook)
			else
				-- alinha olhando pra mesma direção, mantém Y
				local pos = Vector3.new(sidePos.X, myRoot.Position.Y, sidePos.Z)
				myRoot.CFrame = CFrame.new(pos, pos + flatLook)
			end
		end)

		-- movimento: SEU personagem anda/corre com a animação DELE (R6 ou R15)
		pcall(function()
			myHum.WalkSpeed = math.max(tHum.WalkSpeed, 1)
			if myHum.UseJumpPower then
				myHum.JumpPower = tHum.JumpPower
			else
				pcall(function() myHum.JumpHeight = tHum.JumpHeight end)
			end
			local md = tHum.MoveDirection
			if md.Magnitude > 0.05 then
				myHum:Move(md, false)
			else
				myHum:Move(Vector3.zero, false)
			end
			-- velocidade horizontal parecida (ajuda a acompanhar)
			local tv = tRoot.AssemblyLinearVelocity
			myRoot.AssemblyLinearVelocity = Vector3.new(tv.X, myRoot.AssemblyLinearVelocity.Y, tv.Z)
			if tHum.Jump or tHum:GetState() == Enum.HumanoidStateType.Jumping then
				myHum.Jump = true
			end
		end)

		-- danças / emotes (não locomoção) — tenta a mesma animação
		local tAnim = getAnimator(tHum)
		local myAnim = getAnimator(myHum)
		if not tAnim or not myAnim then return end

		local playing = {}
		pcall(function()
			for _, track in ipairs(tAnim:GetPlayingAnimationTracks()) do
				if isLocomotionTrack(track) then
					-- pula: R6 usa walk R6, R15 usa walk R15
				else
					local anim = track.Animation
					if anim and anim.AnimationId and anim.AnimationId ~= "" then
						local id = anim.AnimationId
						playing[id] = track
						if not imitateTracks[id] or not imitateTracks[id].IsPlaying then
							local a = Instance.new("Animation")
							a.AnimationId = id
							local ok, tr = pcall(function()
								return myAnim:LoadAnimation(a)
							end)
							if ok and tr then
								tr.Priority = track.Priority
								tr.Looped = track.Looped
								pcall(function()
									tr:Play(0.1, 1, track.Speed)
									tr.TimePosition = track.TimePosition
								end)
								imitateTracks[id] = tr
							end
						else
							local tr = imitateTracks[id]
							pcall(function()
								if math.abs(tr.TimePosition - track.TimePosition) > 0.35 then
									tr.TimePosition = track.TimePosition
								end
								tr:AdjustSpeed(track.Speed)
							end)
						end
					end
				end
			end
		end)

		for id, tr in pairs(imitateTracks) do
			if not playing[id] then
				pcall(function()
					tr:Stop(0.15)
					tr:Destroy()
				end)
				imitateTracks[id] = nil
			end
		end
	end)
end

btn("Player Mimic: OFF", "ImitateBtn", function()
	if imitateOn then
		stopImitate()
	else
		if makeTrollSelectMenu then
			makeTrollSelectMenu(function(plr)
				startImitate(plr)
			end, false)
		end
	end
end)

-- ========== FOLLOW PLAYER (atrás do alvo) ==========
local followOn = false
local followConn = nil
local followTarget = nil
local followDist = 4

local function stopFollow()
	followOn = false
	followTarget = nil
	if followConn then
		followConn:Disconnect()
		followConn = nil
	end
	local b = B:FindFirstChild("FollowBtn")
	if b then b.Text = "Follow Player: OFF" end
end

local function startFollow(plr)
	stopFollow()
	if not plr or not plr.Character or plr == P then return end
	followOn = true
	followTarget = plr
	local b = B:FindFirstChild("FollowBtn")
	if b then b.Text = "Follow: " .. (plr.DisplayName or plr.Name) end

	followConn = R.Heartbeat:Connect(function()
		if not followOn or not followTarget then
			stopFollow()
			return
		end
		local tChar = followTarget.Character
		local myChar = P.Character
		if not tChar or not myChar then return end
		local th = tChar:FindFirstChild("HumanoidRootPart")
		local hrp = myChar:FindFirstChild("HumanoidRootPart")
		local hum = myChar:FindFirstChildOfClass("Humanoid")
		local tHum = tChar:FindFirstChildOfClass("Humanoid")
		if not th or not hrp or not hum then return end

		local behind = th.Position - th.CFrame.LookVector * followDist
		behind = Vector3.new(behind.X, th.Position.Y, behind.Z)
		local flatLook = Vector3.new(th.CFrame.LookVector.X, 0, th.CFrame.LookVector.Z)
		if flatLook.Magnitude < 0.05 then
			flatLook = Vector3.new(0, 0, -1)
		else
			flatLook = flatLook.Unit
		end

		local toTarget = behind - hrp.Position
		local dist = toTarget.Magnitude
		if dist > 1.2 then
			if dist > 45 then
				hrp.CFrame = CFrame.new(behind, behind + flatLook)
			else
				pcall(function()
					if tHum then hum.WalkSpeed = math.max(tHum.WalkSpeed, 16) end
					hum:Move(toTarget.Unit, false)
				end)
				local pos = hrp.Position:Lerp(behind, 0.18)
				hrp.CFrame = CFrame.new(pos, pos + flatLook)
			end
		else
			hrp.CFrame = CFrame.new(behind, behind + flatLook)
			hum:Move(Vector3.zero, false)
		end
	end)
end

btn("Follow Player: OFF", "FollowBtn", function()
	if followOn then
		stopFollow()
	else
		if makeTrollSelectMenu then
			makeTrollSelectMenu(startFollow, false)
		end
	end
end)


-- ========== FLING PLAYER (método BodyAngularVelocity + colisão) ==========
local flingBusy = false
local function flingPlayer(plr)
	if flingBusy or not plr or plr == P or not plr.Character then return end
	local tChar = plr.Character
	local th = tChar:FindFirstChild("HumanoidRootPart")
	if not th then return end
	local char = P.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end
	flingBusy = true
	local oldPos = hrp.CFrame

	-- garante colisão pra empurrar o alvo
	local savedCollide = {}
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then
			savedCollide[p] = p.CanCollide
			p.CanCollide = true
		end
	end
	pcall(function()
		hrp.CanCollide = true
		hum.PlatformStand = true
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	end)

	-- gira o seu corpo com torque alto (fling clássico)
	local bav = Instance.new("BodyAngularVelocity")
	bav.Name = "DW_FlingSpin"
	bav.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	bav.P = 1e9
	bav.AngularVelocity = Vector3.new(0, 9e5, 0)
	bav.Parent = hrp

	local bv = Instance.new("BodyVelocity")
	bv.Name = "DW_FlingPush"
	bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bv.P = 1e9
	bv.Velocity = Vector3.new(0, 0, 0)
	bv.Parent = hrp

	local t0 = tick()
	local conn
	conn = R.Heartbeat:Connect(function()
		if not th.Parent or not hrp.Parent or tick() - t0 > 1.1 then
			if conn then conn:Disconnect() end
			return
		end
		-- cola no HumanoidRootPart do alvo
		local offset = CFrame.Angles(math.rad(math.random(-90, 90)), math.rad(math.random(-180, 180)), math.rad(math.random(-90, 90)))
		hrp.CFrame = th.CFrame * offset
		-- força linear absurda em direção aleatória + cima
		local force = Vector3.new(
			math.random(-1, 1) * 1e5,
			1e5,
			math.random(-1, 1) * 1e5
		)
		bv.Velocity = force
		pcall(function()
			hrp.AssemblyLinearVelocity = force
			hrp.AssemblyAngularVelocity = Vector3.new(0, 9e5, 0)
			-- tenta empurrar o alvo também (funciona só se tiver ownership)
			th.AssemblyLinearVelocity = force
			th.AssemblyAngularVelocity = Vector3.new(9e4, 9e4, 9e4)
		end)
	end)

	task.delay(1.15, function()
		if conn then conn:Disconnect() end
		pcall(function() if bav then bav:Destroy() end end)
		pcall(function() if bv then bv:Destroy() end end)
		for p, col in pairs(savedCollide) do
			if p and p.Parent then
				pcall(function() p.CanCollide = col end)
			end
		end
		if hrp and hrp.Parent then
			pcall(function()
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				hrp.CFrame = oldPos + Vector3.new(0, 3, 0)
			end)
		end
		if hum and hum.Parent then
			hum.PlatformStand = false
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		end
		flingBusy = false
	end)
end

btn("Fling Player", "FlingBtn", function()
	if makeTrollSelectMenu then
		makeTrollSelectMenu(function(plr)
			flingPlayer(plr)
		end, false)
	end
end)

-- ========== BEAN HEAD (vira feijão na cabeça do alvo) ==========
local beanOn = false
local beanConn = nil
local beanPart = nil
local beanTarget = nil
local beanSaved = {}

local function stopBeanHead()
	beanOn = false
	beanTarget = nil
	if beanConn then
		beanConn:Disconnect()
		beanConn = nil
	end
	if beanPart then
		pcall(function() beanPart:Destroy() end)
		beanPart = nil
	end
	local char = P.Character
	if char then
		for part, data in pairs(beanSaved) do
			if part and part.Parent then
				pcall(function()
					if part:IsA("BasePart") then
						part.LocalTransparencyModifier = data.trans or 0
						part.CanCollide = data.collide ~= false
					elseif part:IsA("Decal") then
						part.Transparency = data.trans or 0
					end
				end)
			end
		end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = false
			hum.AutoRotate = true
		end
	end
	beanSaved = {}
	local b = B:FindFirstChild("BeanHeadBtn")
	if b then b.Text = "Bean Head: OFF" end
end

local function startBeanHead(plr)
	stopBeanHead()
	if not plr or not plr.Character then return end
	local tHead = plr.Character:FindFirstChild("Head")
	if not tHead then return end
	local char = P.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end

	beanOn = true
	beanTarget = plr
	beanSaved = {}

	-- esconde seu corpo (fica só o feijão)
	for _, v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart") then
			beanSaved[v] = {trans = v.LocalTransparencyModifier, collide = v.CanCollide}
			v.LocalTransparencyModifier = 1
			v.CanCollide = false
		elseif v:IsA("Decal") then
			beanSaved[v] = {trans = v.Transparency}
			v.Transparency = 1
		end
	end
	hum.PlatformStand = true
	hum.AutoRotate = false

	-- feijão gigante
	local bean = Instance.new("Part")
	bean.Name = "DW_Bean"
	bean.Shape = Enum.PartType.Ball
	bean.Size = Vector3.new(3.2, 4.2, 3.2)
	bean.Color = Color3.fromRGB(90, 160, 50)
	bean.Material = Enum.Material.SmoothPlastic
	bean.CanCollide = false
	bean.Massless = true
	bean.Anchored = false
	bean.CastShadow = true
	bean.CFrame = tHead.CFrame
	bean.Parent = WS
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1.35, 0.85)
	mesh.Parent = bean
	-- brilho VIP leve
	local light = Instance.new("PointLight", bean)
	light.Color = Color3.fromRGB(120, 200, 70)
	light.Brightness = 1.2
	light.Range = 8
	beanPart = bean

	beanConn = R.RenderStepped:Connect(function()
		if not beanOn then return end
		local target = beanTarget
		if not target or not target.Character then
			stopBeanHead()
			return
		end
		local head = target.Character:FindFirstChild("Head")
		local myHrp = P.Character and P.Character:FindFirstChild("HumanoidRootPart")
		local myHum = P.Character and P.Character:FindFirstChildOfClass("Humanoid")
		if not head or not myHrp or not beanPart then
			stopBeanHead()
			return
		end
		if myHum then
			myHum.PlatformStand = true
			myHum.AutoRotate = false
		end
		-- fica na cabeça do alvo
		local cf = head.CFrame * CFrame.new(0, 2.2, 0)
		myHrp.CFrame = cf
		myHrp.AssemblyLinearVelocity = Vector3.zero
		myHrp.AssemblyAngularVelocity = Vector3.zero
		beanPart.CFrame = cf * CFrame.Angles(0, tick() * 1.5, 0)
	end)

	local b = B:FindFirstChild("BeanHeadBtn")
	if b then b.Text = "Bean Head: ON" end
end

btn("Bean Head: OFF", "BeanHeadBtn", function()
	if beanOn then
		stopBeanHead()
	else
		if makeTrollSelectMenu then
			makeTrollSelectMenu(function(plr)
				startBeanHead(plr)
			end, false)
		end
	end
end)


-- ========== MUTE PLAYER (esconde chat do alvo no seu cliente) ==========
local mutedPlayers = {} -- [UserId] = true
local muteConn = nil

local function ensureMuteHook()
	if muteConn then return end
	-- Text Chat
	pcall(function()
		local chat = game:GetService("Chat")
		muteConn = true
	end)
	pcall(function()
		local sg = game:GetService("StarterGui")
		-- Legacy: filter bubble chat / text chat
	end)
	-- TextChatService (novo chat)
	pcall(function()
		local tcs = game:GetService("TextChatService")
		if tcs and tcs.MessageReceived then
			tcs.MessageReceived:Connect(function(msg)
				local ok, src = pcall(function()
					return msg.TextSource
				end)
				if ok and src and mutedPlayers[src.UserId] then
					pcall(function()
						msg.Text = ""
					end)
				end
			end)
		end
		if tcs and tcs.OnIncomingMessage then
			tcs.OnIncomingMessage = function(msg)
				local props = Instance.new("TextChatMessageProperties")
				local src = msg.TextSource
				if src and mutedPlayers[src.UserId] then
					props.Text = " "
					props.PrefixText = ""
				end
				return props
			end
		end
	end)
	-- DefaultChatSystemChatEvents
	pcall(function()
		local rs = game:GetService("ReplicatedStorage")
		local dcs = rs:FindFirstChild("DefaultChatSystemChatEvents")
		if dcs and dcs:FindFirstChild("OnMessageDoneFiltering") then
			dcs.OnMessageDoneFiltering.OnClientEvent:Connect(function(data)
				if type(data) ~= "table" then return end
				local name = data.FromSpeaker
				if not name then return end
				for _, plr in ipairs(PL:GetPlayers()) do
					if plr.Name == name and mutedPlayers[plr.UserId] then
						-- não tem como apagar remoto fácil; tenta esconder no GUI
						task.defer(function()
							pcall(function()
								local pg = P:FindFirstChild("PlayerGui")
								if not pg then return end
								for _, g in ipairs(pg:GetDescendants()) do
									if g:IsA("TextLabel") or g:IsA("TextButton") then
										local tx = tostring(g.Text or "")
										if tx:find(name, 1, true) and (#tx < 400) then
											if mutedPlayers[plr.UserId] then
												g.Text = ""
												g.Visible = false
											end
										end
									end
								end
							end)
						end)
						break
					end
				end
			end)
		end
	end)
	-- esconde bubble chat do muted
	R.Heartbeat:Connect(function()
		for _, plr in ipairs(PL:GetPlayers()) do
			if mutedPlayers[plr.UserId] and plr.Character then
				local head = plr.Character:FindFirstChild("Head")
				if head then
					for _, ch in ipairs(head:GetChildren()) do
						if ch:IsA("BillboardGui") or ch.Name:lower():find("bubble") then
							pcall(function() ch:Destroy() end)
						end
					end
				end
			end
		end
	end)
end

local function toggleMute(plr)
	if not plr or plr == P then return end
	ensureMuteHook()
	if mutedPlayers[plr.UserId] then
		mutedPlayers[plr.UserId] = nil
	else
		mutedPlayers[plr.UserId] = true
	end
end

btn("Mute Player", "MutePlayerBtn", function()
	if makeTrollSelectMenu then
		makeTrollSelectMenu(function(plr)
			toggleMute(plr)
			local on = mutedPlayers[plr.UserId] == true
			pcall(function()
				game:GetService("StarterGui"):SetCore("SendNotification", {
					Title = "DARK WOLF";
					Text = (on and "Mutado: " or "Desmutado: ") .. plr.Name;
					Duration = 3;
				})
			end)
		end, false)
	end
end)


-- ========== KILL (precisa faca/espada) ==========
local killBusy = false

local function hasMeleeWeapon()
	local char = P.Character
	if not char then return false, nil end
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then
			local n = string.lower(t.Name)
			if n:find("knife") or n:find("sword") or n:find("blade") or n:find("faca") or n:find("espada")
				or n:find("dagger") or n:find("katana") or n:find("machete") or n:find("bat")
				or n:find("axe") or n:find("slash") or t:FindFirstChild("Handle") then
				return true, t
			end
		end
	end
	return false, nil
end

local function tryKillPlayer(plr)
	if not plr or plr == P or not plr.Character then return end
	local has, tool = hasMeleeWeapon()
	if not has or not tool then return false end
	local th = plr.Character:FindFirstChild("HumanoidRootPart")
	local hum = plr.Character:FindFirstChildOfClass("Humanoid")
	local my = P.Character and P.Character:FindFirstChild("HumanoidRootPart")
	if not th or not hum or not my or hum.Health <= 0 then return end
	pcall(function()
		-- chega perto e ativa a arma
		my.CFrame = th.CFrame * CFrame.new(0, 0, 2)
		local myHum = P.Character:FindFirstChildOfClass("Humanoid")
		if myHum then
			pcall(function() myHum:EquipTool(tool) end)
		end
		for _ = 1, 8 do
			pcall(function() tool:Activate() end)
			pcall(function()
				hum:TakeDamage(25)
			end)
			pcall(function()
				hum.Health = math.max(0, hum.Health - 25)
			end)
